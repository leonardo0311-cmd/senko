# Clave para firmar las cookies de sesion. Generar con: openssl rand -hex 32
SENKO_SESSION_SECRET=cambiar-esto-en-produccion-openssl-rand-hex-32

# Clave que usa el bot de WhatsApp para llamar a /api/bot/*
SENKO_BOT_API_KEY=cambiar-esta-clave-del-bot

# Ruta del archivo SQLite (opcional, por defecto ./data/senko.db)
# SENKO_DB_PATH=./data/senko.db

# Zona horaria del servidor. Importante: los turnos se guardan en UTC y se
# muestran en la zona del servidor, así que tiene que ser la del negocio.
TZ=America/Argentina/Buenos_Aires
