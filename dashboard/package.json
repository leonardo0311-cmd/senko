{
  "name": "senko-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard de gestion para el bot de turnos de Senko Intelligence",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
