---
import Base from '@/layouts/Base.astro';
import PortadaPagina from '@/components/PortadaPagina.astro';
import TituloSeccion from '@/components/TituloSeccion.astro';
import TarjetaRasgo from '@/components/TarjetaRasgo.astro';
import BandaCta from '@/components/BandaCta.astro';
import Visual from '@/components/Visual.astro';
import Boton from '@/components/Boton.astro';
import AvisoPendiente from '@/components/AvisoPendiente.astro';
import { MENSAJES, UBICACION, CONTACTO } from '@/data/site';
import { hayFotosPropias } from '@/data/instalaciones';
import FranjaCifras from '@/components/FranjaCifras.astro';
import MuroInstituciones from '@/components/MuroInstituciones.astro';
import { HITOS, hayHitos, aniosDeTrayectoria } from '@/data/trayectoria';

const VALORES = [
  {
    icono: 'escucha' as const,
    titulo: 'Escuchar antes de proponer',
    texto:
      'Ninguna evaluación empieza por el examen físico. Empieza por entender qué te trae, qué probaste y qué te importa recuperar.',
  },
  {
    icono: 'documento' as const,
    titulo: 'Responsabilidad profesional',
    texto:
      'Decimos lo que la evaluación muestra, incluso cuando implica derivarte o plantear que la kinesiología no es el camino para tu caso.',
  },
  {
    icono: 'respeto' as const,
    titulo: 'Respeto por cada proceso',
    texto:
      'Los tiempos de recuperación son individuales. Trabajamos con el ritmo de cada persona y no con plazos prefijados.',
  },
  {
    icono: 'dialogo' as const,
    titulo: 'Comunicación clara',
    texto:
      'Explicamos en palabras entendibles qué está pasando y qué vamos a hacer. Si algo no quedó claro, se vuelve a explicar.',
  },
  {
    icono: 'persona' as const,
    titulo: 'Atención centrada en la persona',
    texto:
      'Dos personas con el mismo diagnóstico no necesitan lo mismo. Lo que cambia es el contexto, el objetivo y la vida de cada una.',
  },
  {
    icono: 'formacion' as const,
    titulo: 'Formación continua',
    texto:
      'La kinesiología se actualiza. Mantenerse al día es parte del trabajo, no un extra.',
  },
];
---

<Base
  titulo="Nosotros | CKC Kinesiología, consultorio kinésico en Canning"
  descripcion="Conocé CKC Kinesiología, consultorio kinésico en Canning: cómo pensamos la kinesiología y por qué la evaluación va siempre antes del tratamiento."
  esquemas={[
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.ckckinesiologia.com.ar/' },
        { '@type': 'ListItem', position: 2, name: 'Nosotros' },
      ],
    },
  ]}
>
  <PortadaPagina
    rotulo="Nosotros"
    titulo="Un consultorio kinésico en Canning"
    bajada="Atendemos a personas que llegan por motivos muy distintos. Lo que no cambia es el punto de partida: entender el caso antes de proponer un tratamiento."
    ruta={[{ texto: 'Nosotros' }]}
    variante="profundo"
  />

  {/* ===================== PRESENTACION ===================== */}
  <section class="ckc-seccion">
    <div class="ckc-contenedor nosotros__intro">
      <div class="ckc-prosa" data-animar>
        <h2>Quiénes somos</h2>
        <p>
          CKC —Consultorio Kinésico Canning— es un consultorio de kinesiología ubicado en
          {' '}{UBICACION.resumen}. Trabajamos en cinco áreas: kinesiología deportiva,
          tratamiento y prevención de lesiones, prevención de caídas, suelo pélvico y MEP,
          con sus líneas Sport y Beauty.
        </p>
        <p>
          A lo largo del tiempo fuimos construyendo una presencia en la zona y una
          comunidad que nos sigue en <a href={CONTACTO.instagram.url} target="_blank" rel="noopener noreferrer">Instagram</a>,
          donde compartimos contenido sobre movimiento, prevención y tratamientos. Este
          sitio busca ordenar esa información y hacerla más fácil de encontrar para quien
          está buscando kinesiología en Canning.
        </p>
        <p>
          Nos interesa que una persona pueda llegar a la consulta sabiendo qué va a pasar.
          Mucha gente nunca hizo un tratamiento kinésico y no sabe qué esperar: si va a
          doler, cuántas sesiones va a necesitar, si hace falta una orden médica. Esas
          dudas frenan consultas que podrían haberse resuelto antes, y por eso les
          dedicamos espacio en <a href="/preguntas-frecuentes/">las preguntas frecuentes</a>
          {' '}y en <a href="/como-trabajamos/">cómo trabajamos</a>.
        </p>

        <AvisoPendiente
          titulo="Sobre la historia del consultorio"
          campo="Confirmar con CKC: año de inicio, origen del proyecto, hitos"
          tono="neutro"
          class="nosotros__aviso"
        >
          <p>
            Esta presentación se construyó con la información pública disponible. No
            inventamos una fecha de fundación, una historia familiar ni una trayectoria
            que no pudimos verificar. Cuando CKC aporte esos datos, esta sección se amplía.
          </p>
        </AvisoPendiente>
      </div>

      <div class="nosotros__visual" data-animar style="--retardo:120ms">
        <Visual
          proporcion="3/4"
          motivo="campo"
          tono="arena"
          rotulo="Foto a incorporar: el consultorio o el equipo de CKC"
          ancho={520}
        />
      </div>
    </div>
  </section>

  {/* ===================== TRAYECTORIA ===================== */}
  <FranjaCifras variante="oscura" conAviso={false} />

  <section class="ckc-seccion ckc-seccion--blanca">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Trayectoria"
        titulo={
          aniosDeTrayectoria
            ? `${aniosDeTrayectoria} años atendiendo en Canning`
            : 'Nuestro recorrido'
        }
        bajada="Cómo fue creciendo el consultorio y con qué instituciones trabajamos."
      />

      {
        hayHitos ? (
          <ol class="hitos">
            {HITOS.map((h, i) => (
              <li data-animar style={`--retardo:${i * 70}ms`}>
                <span class="hitos__anio">{h.anio}</span>
                <div>
                  <h3>{h.titulo}</h3>
                  <p>{h.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <AvisoPendiente
            titulo="Línea de tiempo a completar"
            campo="src/data/trayectoria.ts → anioInicio, HITOS"
            class="nosotros__aviso"
          >
            <p>
              No inventamos una fecha de apertura ni hitos que no podamos verificar.
              Con el año de inicio y tres o cuatro momentos importantes, esta sección
              queda armada y los años se recalculan solos cada enero.
            </p>
          </AvisoPendiente>
        )
      }

      <div class="instituciones">
        <h3 class="instituciones__titulo">Clubes e instituciones</h3>
        <MuroInstituciones vacios={4} />
      </div>
    </div>
  </section>

  {/* ===================== FILOSOFIA ===================== */}
  <section class="ckc-seccion ckc-seccion--arena">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Filosofía de trabajo"
        titulo="Cómo pensamos la kinesiología"
      />

      <div class="filosofia">
        <div class="ckc-prosa" data-animar>
          <p>
            La kinesiología es una disciplina que trabaja sobre el movimiento y la función.
            Puede contribuir a la recuperación funcional, al manejo de determinadas
            molestias y a la mejora de la movilidad, siempre según lo que indique la
            evaluación profesional y el motivo de consulta de cada persona.
          </p>
          <p>
            Esa aclaración no es un detalle legal: es la base de cómo trabajamos. No hay
            un tratamiento que sirva para todas las personas con el mismo diagnóstico,
            porque el diagnóstico es apenas una parte del panorama. Lo que cambia —y cambia
            mucho— es el contexto: cuánto tiempo lleva la molestia, qué actividades afecta,
            qué se intentó antes, cuánto tiempo real tiene esa persona para dedicarle a un
            tratamiento y qué quiere poder volver a hacer.
          </p>
          <p>
            Por eso dedicamos tiempo a la evaluación inicial y a conversar. Una persona
            que entiende qué le está pasando y por qué hace lo que hace toma mejores
            decisiones cuando está sola, que es la mayor parte del tiempo. La participación
            del paciente no es un complemento del tratamiento: en muchos casos es la parte
            que define el resultado.
          </p>
          <p>
            También nos parece importante ser claros sobre los límites. Ningún tratamiento
            puede garantizar que un dolor desaparezca ni fijar de antemano un plazo exacto
            de recuperación. Lo que sí podemos hacer es evaluar con seriedad, plantear
            objetivos razonables, explicar el proceso, revisar la evolución y ajustar lo
            que haga falta. Si en algún momento consideramos que el abordaje no está
            aportando, lo vamos a decir.
          </p>
        </div>

        <aside class="filosofia__destacado" data-animar style="--retardo:100ms">
          <p class="filosofia__cita">
            «Una misma molestia puede tener causas distintas en dos personas. Por eso la
            evaluación va antes que el tratamiento, siempre.»
          </p>
          <Boton href="/como-trabajamos/" variante="contorno" flecha>
            Ver cómo es el proceso
          </Boton>
        </aside>
      </div>
    </div>
  </section>

  {/* ===================== VALORES ===================== */}
  <section class="ckc-seccion">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Valores"
        titulo="Lo que sostiene la atención"
        bajada="No como una lista de palabras lindas, sino como las decisiones concretas que tomamos todos los días en la consulta."
      />

      <div class="ckc-grilla ckc-grilla--3">
        {
          VALORES.map((v, i) => (
            <TarjetaRasgo
              icono={v.icono}
              titulo={v.titulo}
              texto={v.texto}
              retardo={i * 60}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ===================== EQUIPO Y ESPACIO ===================== */}
  <section class="ckc-seccion ckc-seccion--blanca">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="El equipo y el espacio"
        titulo="Conocé el lugar antes de venir"
        bajada="Saber a dónde vas y quién te va a atender hace que la primera consulta sea más fácil. Son dos secciones propias del sitio."
      />

      <div class="espacio">
        <a class="espacio__tarjeta" href="/profesionales/" data-animar>
          <Visual proporcion="16/9" motivo="eje" tono="primario" ancho={560} />
          <div class="espacio__cuerpo">
            <h3>Equipo profesional</h3>
            <p>
              Las fichas de los profesionales del consultorio, con su formación y sus
              áreas de atención.
            </p>
            <span class="espacio__enlace">
              Ver el equipo
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>

        <a class="espacio__tarjeta" href="/instalaciones/" data-animar style="--retardo:90ms">
          <Visual proporcion="16/9" motivo="horizonte" tono="arena" ancho={560} />
          <div class="espacio__cuerpo">
            <h3>Instalaciones</h3>
            <p>
              El espacio físico donde atendemos: recepción, consultorios y áreas de
              tratamiento.
            </p>
            <span class="espacio__enlace">
              Ver las instalaciones
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      </div>

      {
        !hayFotosPropias && (
          <AvisoPendiente
            titulo="Fotografías propias pendientes"
            campo="src/data/instalaciones.ts → GALERIA"
            class="espacio__aviso"
          >
            <p>
              No usamos fotos de otros centros ni imágenes genéricas que puedan hacerse
              pasar por el consultorio. Los espacios reservados están listos para
              incorporar las fotografías reales de CKC.
            </p>
          </AvisoPendiente>
        )
      }
    </div>
  </section>

  <BandaCta
    titulo="¿Te quedaron dudas sobre cómo trabajamos?"
    texto="Escribinos y las conversamos. No hace falta tener el diagnóstico claro para hacer una consulta."
    mensaje={MENSAJES.general}
    textoBoton="Hacer una consulta"
    secundario={{ texto: 'Ver nuestros servicios', href: '/servicios/' }}
  />
</Base>

<style>
  .nosotros__intro {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .nosotros__intro h2 {
    margin-top: 0;
  }

  /* :global porque la clase va a la raíz de <AvisoPendiente>. */
  :global(.nosotros__aviso) {
    margin-top: var(--ckc-esp-6);
  }

  @media (min-width: 60rem) {
    .nosotros__intro {
      grid-template-columns: 1fr 22rem;
    }
  }

  @media (max-width: 44rem) {
    .nosotros__visual {
      display: none;
    }
  }


  /* --- Trayectoria ------------------------------------------------------ */

  .hitos {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--ckc-esp-5);
  }

  .hitos li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--ckc-esp-5);
    align-items: start;
    padding-bottom: var(--ckc-esp-5);
    border-bottom: 1px solid var(--ckc-linea-suave);
  }

  .hitos li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .hitos__anio {
    font-family: var(--ckc-fuente-titulo);
    font-size: var(--ckc-txt-xl);
    color: var(--ckc-acento);
    font-variant-numeric: tabular-nums;
    min-width: 4.5ch;
  }

  .hitos h3 {
    font-size: var(--ckc-txt-lg);
    margin-bottom: var(--ckc-esp-2);
  }

  .hitos p {
    color: var(--ckc-tinta-media);
    line-height: 1.68;
    max-width: var(--ckc-ancho-texto);
  }

  .instituciones {
    margin-top: var(--ckc-esp-8);
    padding-top: var(--ckc-esp-7);
    border-top: 1px solid var(--ckc-linea);
  }

  .instituciones__titulo {
    font-family: var(--ckc-fuente-texto);
    font-size: var(--ckc-txt-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ckc-acento);
    margin-bottom: var(--ckc-esp-5);
  }

  /* --- Filosofia --------------------------------------------------------- */

  .filosofia {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .filosofia__destacado {
    padding: var(--ckc-esp-6);
    background: var(--ckc-blanco);
    border-left: 2px solid var(--ckc-acento);
    border-radius: 0 var(--ckc-radio-md) var(--ckc-radio-md) 0;
  }

  .filosofia__cita {
    font-family: var(--ckc-fuente-titulo);
    font-size: var(--ckc-txt-lg);
    font-style: italic;
    line-height: 1.5;
    color: var(--ckc-primario-oscuro);
    margin-bottom: var(--ckc-esp-5);
  }

  @media (min-width: 64rem) {
    .filosofia {
      grid-template-columns: 1fr 21rem;
    }
  }

  /* --- Equipo y espacio -------------------------------------------------- */

  .espacio {
    display: grid;
    gap: var(--ckc-esp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .espacio__tarjeta {
    display: block;
    background: var(--ckc-fondo);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--ckc-trans),
      box-shadow var(--ckc-trans),
      translate var(--ckc-trans);
  }

  .espacio__tarjeta:hover {
    border-color: color-mix(in srgb, var(--ckc-primario) 28%, transparent);
    box-shadow: var(--ckc-sombra-md);
    translate: 0 -2px;
  }

  .espacio__tarjeta :global(.ckc-visual) {
    border-radius: 0;
  }

  .espacio__cuerpo {
    padding: var(--ckc-esp-5);
  }

  .espacio__cuerpo h3 {
    font-size: var(--ckc-txt-lg);
    margin-bottom: var(--ckc-esp-2);
  }

  .espacio__tarjeta:hover h3 {
    color: var(--ckc-primario);
  }

  .espacio__cuerpo p {
    font-size: var(--ckc-txt-sm);
    line-height: 1.65;
    color: var(--ckc-tinta-media);
    margin-bottom: var(--ckc-esp-4);
  }

  .espacio__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--ckc-txt-sm);
    font-weight: 650;
    color: var(--ckc-primario);
  }

  .espacio__enlace svg {
    width: 1rem;
    height: 1rem;
    transition: translate var(--ckc-trans);
  }

  .espacio__tarjeta:hover .espacio__enlace svg {
    translate: 3px 0;
  }

  /* :global porque la clase va a la raíz de <AvisoPendiente>. */
  :global(.espacio__aviso) {
    margin-top: var(--ckc-esp-6);
  }
</style>
