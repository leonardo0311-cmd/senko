---
import Base from '@/layouts/Base.astro';
import PortadaPagina from '@/components/PortadaPagina.astro';
import Formulario from '@/components/Formulario.astro';
import BotonTurno from '@/components/BotonTurno.astro';
import AvisoPendiente from '@/components/AvisoPendiente.astro';
import Icono from '@/components/Icono.astro';
import {
  CONTACTO,
  UBICACION,
  HORARIOS,
  MENSAJES,
  hayWhatsApp,
  hayTelefono,
  hayEmail,
  hayDireccion,
  hayMapa,
  hayHorarios,
  direccionEnLinea,
} from '@/data/site';
import { SITE } from '@/data/site-url.mjs';
---

<Base
  titulo="Contacto y turnos | CKC Kinesiología, Canning"
  descripcion="Contactate con CKC Kinesiología en Canning para consultar por un turno. Escribinos por WhatsApp o Instagram, o dejanos tu consulta en el formulario."
  sinFlotante={true}
  esquemas={[
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Contacto y turnos' },
      ],
    },
  ]}
>
  <PortadaPagina
    rotulo="Contacto y turnos"
    titulo="Hablemos de tu consulta"
    bajada="Contanos qué te pasa y te orientamos sobre los próximos pasos. Si hace falta una evaluación, coordinamos un turno."
    ruta={[{ texto: 'Contacto y turnos' }]}
    variante="profundo"
  />

  {/* ===================== CANALES ===================== */}
  <section class="ckc-seccion" id="canales">
    <div class="ckc-contenedor">
      <h2 class="ckc-visualmente-oculto">Canales de contacto</h2>

      <div class="canales">
        {/* --- WhatsApp --- */}
        <article class:list={['canal', hayWhatsApp && 'canal--destacado']} data-animar>
          <span class="canal__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
              <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.22-1.37a9.9 9.9 0 0 0 4.82 1.23h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.88 9.88 0 0 0 12.04 2Zm0 1.67c2.21 0 4.29.86 5.85 2.43a8.23 8.23 0 0 1 2.43 5.86c0 4.58-3.72 8.3-8.29 8.3a8.26 8.26 0 0 1-4.21-1.15l-.3-.18-3.1.81.83-3.02-.19-.31a8.24 8.24 0 0 1-1.27-4.42c0-4.58 3.72-8.3 8.3-8.3Zm-3.1 4.3c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.42 1.02 2.59.13.16 1.75 2.72 4.24 3.7 2.07.82 2.49.65 2.94.61.45-.04 1.45-.59 1.66-1.17.2-.57.2-1.07.14-1.17-.06-.1-.23-.17-.48-.29-.25-.12-1.45-.71-1.67-.79-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.98-.14.16-.29.19-.54.06-.25-.12-1.05-.38-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.12.29-.31.43-.47.14-.16.19-.27.29-.45.1-.17.05-.33-.02-.45-.06-.13-.56-1.36-.77-1.86-.2-.49-.4-.42-.56-.43h-.5Z" />
            </svg>
          </span>
          <h3>WhatsApp</h3>
          {
            hayWhatsApp ? (
              <Fragment>
                <p>
                  La vía más rápida para consultar por un turno. Escribinos y te
                  respondemos.
                </p>
                <BotonTurno mensaje={MENSAJES.turno} texto="Abrir WhatsApp" />
              </Fragment>
            ) : (
              <Fragment>
                <p>
                  El número de WhatsApp del consultorio todavía está pendiente de
                  confirmación. No publicamos un número sin verificar para que nadie
                  escriba a un destinatario equivocado.
                </p>
                <p class="canal__alternativa">
                  Mientras tanto, el canal activo es Instagram.
                </p>
              </Fragment>
            )
          }
        </article>

        {/* --- Instagram --- */}
        <article class:list={['canal', !hayWhatsApp && 'canal--destacado']} data-animar style="--retardo:70ms">
          <span class="canal__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
              <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.96.24 2.65.5.71.28 1.31.65 1.91 1.25.6.6.97 1.2 1.25 1.91.26.69.45 1.48.5 2.65.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.96-.5 2.65-.28.71-.65 1.31-1.25 1.91-.6.6-1.2.97-1.91 1.25-.69.26-1.48.45-2.65.5-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.96-.24-2.65-.5-.71-.28-1.31-.65-1.91-1.25-.6-.6-.97-1.2-1.25-1.91-.26-.69-.45-1.48-.5-2.65C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.24-1.96.5-2.65.28-.71.65-1.31 1.25-1.91.6-.6 1.2-.97 1.91-1.25.69-.26 1.48-.45 2.65-.5C8.42 2.17 8.8 2.16 12 2.16Zm0 1.8c-3.15 0-3.5.01-4.73.07-.95.04-1.47.2-1.81.34-.46.18-.79.39-1.13.74-.35.34-.56.67-.74 1.13-.14.34-.3.86-.34 1.81-.06 1.23-.07 1.58-.07 4.73s.01 3.5.07 4.73c.04.95.2 1.47.34 1.81.18.46.39.79.74 1.13.34.35.67.56 1.13.74.34.14.86.3 1.81.34 1.23.06 1.58.07 4.73.07s3.5-.01 4.73-.07c.95-.04 1.47-.2 1.81-.34.46-.18.79-.39 1.13-.74.35-.34.56-.67.74-1.13.14-.34.3-.86.34-1.81.06-1.23.07-1.58.07-4.73s-.01-3.5-.07-4.73c-.04-.95-.2-1.47-.34-1.81a3.05 3.05 0 0 0-.74-1.13c-.34-.35-.67-.56-1.13-.74-.34-.14-.86-.3-1.81-.34-1.23-.06-1.58-.07-4.73-.07Zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96Zm0 8.21a3.23 3.23 0 1 0 0-6.46 3.23 3.23 0 0 0 0 6.46Zm6.34-8.41a1.16 1.16 0 1 1-2.33 0 1.16 1.16 0 0 1 2.33 0Z" />
            </svg>
          </span>
          <h3>Instagram</h3>
          <p>
            Nuestro canal activo. Escribinos por mensaje directo a
            {' '}<strong>{CONTACTO.instagram.usuario}</strong> y también podés ver
            contenido sobre tratamientos y prevención.
          </p>
          <a
            class="canal__boton"
            href={CONTACTO.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribinos por Instagram
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </article>

        {/* --- Telefono --- */}
        <article class="canal" data-animar style="--retardo:140ms">
          <span class="canal__icono" aria-hidden="true">
            <Icono nombre="dialogo" />
          </span>
          <h3>Teléfono</h3>
          {
            hayTelefono && CONTACTO.telefono ? (
              <Fragment>
                <p>Podés llamarnos durante el horario de atención.</p>
                <a class="canal__boton" href={`tel:+${CONTACTO.telefono.link}`}>
                  {CONTACTO.telefono.display}
                </a>
              </Fragment>
            ) : (
              <p>
                El teléfono del consultorio está pendiente de confirmación. Existe un
                número publicado por directorios externos, pero no pudimos verificarlo en
                un canal oficial de CKC, así que preferimos no publicarlo.
              </p>
            )
          }
        </article>

        {/* --- Correo --- */}
        <article class="canal" data-animar style="--retardo:210ms">
          <span class="canal__icono" aria-hidden="true">
            <Icono nombre="documento" />
          </span>
          <h3>Correo electrónico</h3>
          {
            hayEmail && CONTACTO.email ? (
              <Fragment>
                <p>Para consultas que no requieren respuesta inmediata.</p>
                <a class="canal__boton" href={`mailto:${CONTACTO.email}`}>
                  {CONTACTO.email}
                </a>
              </Fragment>
            ) : (
              <p>
                Todavía no hay una dirección de correo confirmada para el consultorio. Si
                preferís este medio, avisanos por Instagram y lo coordinamos.
              </p>
            )
          }
        </article>
      </div>
    </div>
  </section>

  {/* ===================== UBICACION Y HORARIOS ===================== */}
  <section class="ckc-seccion ckc-seccion--arena">
    <div class="ckc-contenedor">
      <div class="ubicacion">
        <div class="ubicacion__datos" data-animar>
          <p class="ckc-rotulo">Dónde estamos</p>
          <h2>Ubicación y horarios</h2>

          <dl class="ubicacion__lista">
            <div>
              <dt>
                <span class="ubicacion__icono" aria-hidden="true">
                  <Icono nombre="ubicacion" />
                </span>
                Dirección
              </dt>
              <dd>
                {
                  hayDireccion && direccionEnLinea ? (
                    direccionEnLinea
                  ) : (
                    <Fragment>
                      {UBICACION.resumen}
                      <span class="ubicacion__pendiente">
                        La dirección exacta está pendiente de confirmación. Escribinos y
                        te la pasamos junto con las indicaciones para llegar.
                      </span>
                    </Fragment>
                  )
                }
              </dd>
            </div>

            <div>
              <dt>
                <span class="ubicacion__icono" aria-hidden="true">
                  <Icono nombre="tiempo" />
                </span>
                Horarios de atención
              </dt>
              <dd>
                {
                  hayHorarios && HORARIOS.lista ? (
                    <Fragment>
                      <ul class="ubicacion__horarios">
                        {HORARIOS.lista.map((h) => (
                          <li>
                            <strong>{h.dias}</strong>
                            {h.franjas.join(' y ')}
                          </li>
                        ))}
                      </ul>
                      {HORARIOS.nota && (
                        <span class="ubicacion__pendiente">{HORARIOS.nota}</span>
                      )}
                    </Fragment>
                  ) : (
                    <span class="ubicacion__pendiente ckc-sin-margen-sup">
                      Los horarios están pendientes de confirmación. Consultanos la
                      disponibilidad actual y coordinamos un turno que te sirva.
                    </span>
                  )
                }
              </dd>
            </div>

            <div>
              <dt>
                <span class="ubicacion__icono" aria-hidden="true">
                  <Icono nombre="calendario" />
                </span>
                Turnos
              </dt>
              <dd>
                Los turnos se coordinan por WhatsApp o Instagram. No tenemos un sistema de
                reservas en línea: preferimos conversar la consulta antes de asignar un
                turno, para que te toque la atención que corresponde.
              </dd>
            </div>
          </dl>
        </div>

        {/* --- Mapa --- */}
        <div class="ubicacion__mapa" data-animar style="--retardo:110ms">
          {
            hayMapa && UBICACION.mapaEmbedUrl ? (
              <iframe
                src={UBICACION.mapaEmbedUrl}
                title="Mapa con la ubicación de CKC Kinesiología en Canning"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              />
            ) : (
              <div class="mapa-pendiente">
                <svg viewBox="0 0 400 300" fill="none" aria-hidden="true" focusable="false">
                  <rect width="400" height="300" fill="#eef4f3" />
                  <g class="mapa-pendiente__trazos">
                    <path d="M-10 90h420M-10 170h420M-10 230h420" />
                    <path d="M90 -10v320M210 -10v320M310 -10v320" />
                  </g>
                  <circle cx="200" cy="150" r="46" class="mapa-pendiente__aro" />
                  <circle cx="200" cy="150" r="26" class="mapa-pendiente__aro" />
                  <circle cx="200" cy="150" r="6" class="mapa-pendiente__punto" />
                </svg>
                <div class="mapa-pendiente__texto">
                  <p class="mapa-pendiente__titulo">Mapa pendiente de confirmación</p>
                  <p>
                    No cargamos un mapa hasta tener la dirección exacta verificada: un
                    punto equivocado haría que alguien viaje al lugar errado.
                  </p>
                </div>
              </div>
            )
          }
        </div>
      </div>

      {
        (!hayDireccion || !hayHorarios || !hayWhatsApp) && (
          <AvisoPendiente
            titulo="Datos de contacto pendientes de confirmación"
            campo="src/data/site.ts → CONTACTO, UBICACION, HORARIOS"
            class="ubicacion__aviso"
          >
            <p>
              Los datos que faltan —número de WhatsApp, teléfono, dirección exacta,
              horarios y coberturas— están identificados en un único archivo de
              configuración. En cuanto CKC los confirme, aparecen automáticamente en todo
              el sitio: pie de página, esta sección, los botones de contacto y los datos
              estructurados para buscadores.
            </p>
          </AvisoPendiente>
        )
      }
    </div>
  </section>

  {/* ===================== FORMULARIO ===================== */}
  <section class="ckc-seccion">
    <div class="ckc-contenedor formulario">
      <div class="formulario__texto" data-animar>
        <p class="ckc-rotulo">Formulario</p>
        <h2>Dejanos tu consulta</h2>
        <p class="ckc-bajada">
          Si preferís no escribir un mensaje desde cero, completá estos campos y armamos
          la consulta por vos.
        </p>

        <ul class="formulario__notas">
          <li>
            <strong>No pedimos información médica detallada.</strong> El motivo de consulta
            es una categoría general y el mensaje es opcional. Lo clínico se ve en la
            consulta.
          </li>
          <li>
            <strong>No simulamos envíos.</strong> Mientras no haya un sistema de recepción
            configurado, el formulario arma tu mensaje y lo abre en WhatsApp para que lo
            envíes. No vas a ver un cartel de "mensaje enviado" si nadie lo recibió.
          </li>
          <li>
            <strong>Usamos tus datos solo para responderte.</strong> Podés leer el detalle
            en la <a href="/politica-de-privacidad/">política de privacidad</a>.
          </li>
        </ul>
      </div>

      <div class="formulario__caja" data-animar style="--retardo:100ms">
        <Formulario />
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Canales ---------------------------------------------------------- */

  .canales {
    display: grid;
    gap: var(--ckc-esp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .canal {
    display: flex;
    flex-direction: column;
    gap: var(--ckc-esp-3);
    padding: var(--ckc-esp-6);
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio-md);
    transition: border-color var(--ckc-trans), box-shadow var(--ckc-trans);
  }

  .canal:hover {
    border-color: color-mix(in srgb, var(--ckc-primario) 26%, transparent);
    box-shadow: var(--ckc-sombra);
  }

  .canal--destacado {
    border-color: color-mix(in srgb, var(--ckc-primario) 38%, transparent);
    background: var(--ckc-primario-claro);
  }

  .canal__icono {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--ckc-esp-2);
    border-radius: var(--ckc-radio);
    background: var(--ckc-primario-claro);
    color: var(--ckc-primario);
  }

  .canal--destacado .canal__icono {
    background: var(--ckc-blanco);
  }

  .canal__icono svg,
  .canal__icono :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .canal h3 {
    font-size: var(--ckc-txt-lg);
  }

  .canal p {
    font-size: var(--ckc-txt-sm);
    line-height: 1.65;
    color: var(--ckc-tinta-media);
  }

  .canal__alternativa {
    font-weight: 600;
    color: var(--ckc-primario-oscuro) !important;
  }

  .canal :global(.ckc-boton) {
    margin-top: auto;
    align-self: flex-start;
  }

  .canal__boton {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: auto;
    min-height: 2.75rem;
    padding: 0.55rem 0;
    font-size: var(--ckc-txt-sm);
    font-weight: 650;
    color: var(--ckc-primario);
    text-decoration: none;
  }

  .canal__boton svg {
    width: 1rem;
    height: 1rem;
    transition: translate var(--ckc-trans);
  }

  .canal__boton:hover svg {
    translate: 3px 0;
  }

  /* --- Ubicacion -------------------------------------------------------- */

  .ubicacion {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .ubicacion {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ubicacion__datos h2 {
    font-size: var(--ckc-txt-2xl);
    margin-bottom: var(--ckc-esp-6);
  }

  .ubicacion__lista {
    display: grid;
    gap: var(--ckc-esp-6);
    margin: 0;
  }

  .ubicacion__lista dt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--ckc-txt-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ckc-acento);
    margin-bottom: var(--ckc-esp-3);
  }

  .ubicacion__icono {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--ckc-primario);
  }

  .ubicacion__icono :global(svg) {
    width: 100%;
    height: 100%;
  }

  .ubicacion__lista dd {
    margin: 0;
    padding-left: 2.1rem;
    font-size: var(--ckc-txt-base);
    line-height: 1.68;
    color: var(--ckc-tinta-media);
  }

  .ubicacion__pendiente {
    display: block;
    margin-top: var(--ckc-esp-2);
    font-size: var(--ckc-txt-sm);
    line-height: 1.6;
    color: var(--ckc-tinta-suave);
    font-style: italic;
  }

  .ubicacion__horarios {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .ubicacion__horarios strong {
    display: block;
    font-size: var(--ckc-txt-sm);
  }

  /* :global porque la clase va a la raíz de <AvisoPendiente>. */
  :global(.ubicacion__aviso) {
    margin-top: var(--ckc-esp-7);
  }

  /* --- Mapa ------------------------------------------------------------- */

  .ubicacion__mapa {
    border-radius: var(--ckc-radio-md);
    overflow: hidden;
    border: 1px solid var(--ckc-linea);
    background: var(--ckc-blanco);
  }

  .ubicacion__mapa iframe {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
  }

  .mapa-pendiente {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .mapa-pendiente svg {
    width: 100%;
    height: 100%;
  }

  .mapa-pendiente__trazos path {
    stroke: color-mix(in srgb, var(--ckc-primario-oscuro) 10%, transparent);
    stroke-width: 1;
  }

  .mapa-pendiente__aro {
    stroke: color-mix(in srgb, var(--ckc-primario) 32%, transparent);
    stroke-width: 1.3;
    stroke-dasharray: 4 6;
  }

  .mapa-pendiente__punto {
    fill: var(--ckc-acento);
  }

  .mapa-pendiente__texto {
    position: absolute;
    inset-inline: 1rem;
    bottom: 1rem;
    padding: 0.9rem 1.1rem;
    background: color-mix(in srgb, var(--ckc-blanco) 94%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio);
  }

  .mapa-pendiente__titulo {
    font-size: var(--ckc-txt-sm);
    font-weight: 650;
    color: var(--ckc-primario-oscuro);
    margin-bottom: 0.2rem;
  }

  .mapa-pendiente__texto p:last-child {
    font-size: var(--ckc-txt-xs);
    line-height: 1.55;
    color: var(--ckc-tinta-media);
  }

  /* --- Formulario ------------------------------------------------------- */

  .formulario {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .formulario {
      grid-template-columns: 20rem 1fr;
    }
  }

  .formulario__texto h2 {
    font-size: var(--ckc-txt-2xl);
  }

  .formulario__notas {
    list-style: none;
    margin: var(--ckc-esp-6) 0 0;
    display: grid;
    gap: var(--ckc-esp-4);
  }

  .formulario__notas li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--ckc-txt-sm);
    line-height: 1.6;
    color: var(--ckc-tinta-media);
  }

  .formulario__notas li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.4px solid var(--ckc-acento);
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    rotate: 45deg;
  }
</style>
