---
import Base from '@/layouts/Base.astro';
import PortadaPagina from '@/components/PortadaPagina.astro';
import Acordeon from '@/components/Acordeon.astro';
import BandaCta from '@/components/BandaCta.astro';
import { PREGUNTAS, GRUPOS, preguntasDeGrupo } from '@/data/preguntas';
import { MENSAJES } from '@/data/site';
import { SITE } from '@/data/site-url.mjs';

/**
 * Para los datos estructurados se limpia el HTML de las respuestas y se quitan
 * las marcas internas [COMPLETAR ...], que son notas para el equipo y no
 * tienen que llegar a los buscadores.
 */
const limpiar = (texto: string) =>
  texto
    .replace(/\[COMPLETAR[^\]]*\]/g, '')
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
---

<Base
  titulo="Preguntas frecuentes | CKC Kinesiología, Canning"
  descripcion="Dudas habituales antes de consultar en CKC Canning: cómo pedir un turno, qué llevar, si hace falta orden médica y cuántas sesiones se necesitan."
  esquemas={[
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Preguntas frecuentes' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: PREGUNTAS.map((p) => ({
        '@type': 'Question',
        name: p.pregunta,
        acceptedAnswer: {
          '@type': 'Answer',
          text: p.respuesta.map(limpiar).join(' '),
        },
      })),
    },
  ]}
>
  <PortadaPagina
    rotulo="Preguntas frecuentes"
    titulo="Las dudas que aparecen antes de consultar"
    bajada="Reunimos las consultas que más nos hacen. Donde la respuesta depende de una cuestión administrativa que todavía tenemos que confirmar, lo decimos en lugar de inventar un dato."
    ruta={[{ texto: 'Preguntas frecuentes' }]}
  >
    <nav class="atajos" aria-label="Categorías de preguntas">
      <ul>
        {GRUPOS.map((g) => <li><a href={`#${g.id}`}>{g.titulo}</a></li>)}
      </ul>
    </nav>
  </PortadaPagina>

  <section class="ckc-seccion">
    <div class="ckc-contenedor faq">
      <div class="faq__cuerpo">
        {
          GRUPOS.map((grupo) => (
            <section class="faq__grupo" id={grupo.id}>
              <header class="faq__grupo-encabezado" data-animar>
                <h2>{grupo.titulo}</h2>
                <p>{grupo.descripcion}</p>
              </header>
              <Acordeon preguntas={preguntasDeGrupo(grupo.id)} />
            </section>
          ))
        }
      </div>

      <aside class="faq__lateral">
        <div class="faq__caja" data-animar>
          <h2>¿Tu duda no está acá?</h2>
          <p>
            Escribinos y te respondemos. No hace falta que tengas el diagnóstico claro ni
            que sepas a qué área corresponde tu consulta.
          </p>
          <p class="faq__nota">
            Eso sí: por mensaje podemos darte una orientación administrativa y contarte
            cómo seguir, pero no diagnosticar ni indicar un tratamiento. Eso requiere una
            evaluación presencial.
          </p>
        </div>

        <ul class="faq__enlaces" data-animar style="--retardo:90ms">
          <li><a href="/como-trabajamos/">Cómo es el proceso de atención</a></li>
          <li><a href="/servicios/">Las cinco áreas de atención</a></li>
          <li><a href="/especialidades/">Buscar por motivo de consulta</a></li>
          <li><a href="/contacto/">Contacto, ubicación y turnos</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <BandaCta
    titulo="¿Seguimos la conversación?"
    texto="Contanos tu caso y te orientamos sobre los próximos pasos."
    mensaje={MENSAJES.general}
    textoBoton="Hacer una consulta"
    secundario={{ texto: 'Ver contacto y ubicación', href: '/contacto/' }}
  />
</Base>

<style>
  .atajos {
    margin-top: var(--ckc-esp-7);
    padding-top: var(--ckc-esp-5);
    border-top: 1px solid color-mix(in srgb, var(--ckc-primario-oscuro) 12%, transparent);
  }

  .atajos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
  }

  .atajos a {
    display: inline-block;
    padding: 0.5rem 0.95rem;
    background: color-mix(in srgb, var(--ckc-blanco) 76%, transparent);
    border: 1px solid color-mix(in srgb, var(--ckc-primario) 16%, transparent);
    border-radius: var(--ckc-radio-pastilla);
    font-size: var(--ckc-txt-xs);
    font-weight: 600;
    color: var(--ckc-primario-oscuro);
    text-decoration: none;
    transition: background-color var(--ckc-trans), border-color var(--ckc-trans);
  }

  .atajos a:hover {
    background: var(--ckc-blanco);
    border-color: var(--ckc-primario);
  }

  /* --- Disposicion ------------------------------------------------------ */

  .faq {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .faq {
      grid-template-columns: 1fr 20rem;
    }
  }

  .faq__grupo {
    scroll-margin-top: calc(var(--ckc-alto-encabezado) + 2rem);
  }

  .faq__grupo + .faq__grupo {
    margin-top: var(--ckc-esp-9);
  }

  .faq__grupo-encabezado {
    margin-bottom: var(--ckc-esp-5);
  }

  .faq__grupo-encabezado h2 {
    font-size: var(--ckc-txt-xl);
    margin-bottom: var(--ckc-esp-2);
  }

  .faq__grupo-encabezado p {
    font-size: var(--ckc-txt-sm);
    color: var(--ckc-tinta-suave);
  }

  /* --- Lateral ---------------------------------------------------------- */

  .faq__lateral {
    display: grid;
    gap: var(--ckc-esp-5);
  }

  @media (min-width: 64rem) {
    .faq__lateral {
      position: sticky;
      top: calc(var(--ckc-alto-encabezado) + 2rem);
    }
  }

  .faq__caja {
    padding: var(--ckc-esp-5);
    background: var(--ckc-primario-claro);
    border-radius: var(--ckc-radio-md);
  }

  .faq__caja h2 {
    font-size: var(--ckc-txt-base);
    font-family: var(--ckc-fuente-texto);
    font-weight: 650;
    margin-bottom: var(--ckc-esp-3);
  }

  .faq__caja p {
    font-size: var(--ckc-txt-sm);
    line-height: 1.68;
    color: var(--ckc-tinta-media);
  }

  .faq__caja p + p {
    margin-top: var(--ckc-esp-3);
  }

  .faq__nota {
    padding-top: var(--ckc-esp-3);
    border-top: 1px solid color-mix(in srgb, var(--ckc-primario) 18%, transparent);
    font-size: var(--ckc-txt-xs) !important;
  }

  .faq__enlaces {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 0.2rem;
  }

  .faq__enlaces a {
    display: block;
    min-height: var(--ckc-tactil-min);
    padding: 0.75rem 1rem;
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio);
    font-size: var(--ckc-txt-sm);
    font-weight: 600;
    color: var(--ckc-primario-oscuro);
    text-decoration: none;
    transition: border-color var(--ckc-trans), translate var(--ckc-trans);
  }

  .faq__enlaces a:hover {
    border-color: var(--ckc-primario);
    translate: 2px 0;
  }
</style>
