---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import PortadaPagina from '@/components/PortadaPagina.astro';
import Acordeon from '@/components/Acordeon.astro';
import BandaCta from '@/components/BandaCta.astro';
import BotonTurno from '@/components/BotonTurno.astro';
import Visual from '@/components/Visual.astro';
import Icono from '@/components/Icono.astro';
import { SERVICIOS } from '@/data/servicios';
import { MENSAJES } from '@/data/site';
import { fotoDeServicio, TEXTOS_ALT } from '@/data/fotos';
import { SITE } from '@/data/site-url.mjs';

export const getStaticPaths = (() =>
  SERVICIOS.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }))) satisfies GetStaticPaths;

const { servicio: s } = Astro.props;
const foto = fotoDeServicio(s.slug);

/** Otros servicios, para los enlaces internos del final. */
const otros = SERVICIOS.filter((o) => o.slug !== s.slug);

/** Indice de la pagina, para navegar dentro de un contenido largo. */
const SECCIONES = [
  { id: 'descripcion', texto: 'En qué consiste' },
  { id: 'situaciones', texto: 'Cuándo puede estar indicado' },
  { id: 'objetivos', texto: 'Objetivos' },
  { id: 'evaluacion', texto: 'La evaluación inicial' },
  { id: 'proceso', texto: 'El proceso de tratamiento' },
  { id: 'participacion', texto: 'Tu participación' },
  { id: 'preguntas', texto: 'Preguntas frecuentes' },
];
---

<Base
  titulo={s.tituloSeo}
  descripcion={s.descripcionSeo}
  esquemas={[
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE}/servicios/` },
        { '@type': 'ListItem', position: 3, name: s.nombre },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: s.preguntas.map((p) => ({
        '@type': 'Question',
        name: p.pregunta,
        acceptedAnswer: {
          '@type': 'Answer',
          text: p.respuesta.join(' '),
        },
      })),
    },
  ]}
>
  <PortadaPagina
    rotulo="Servicio"
    titulo={s.nombre}
    bajada={s.resumen}
    ruta={[{ texto: 'Servicios', href: '/servicios/' }, { texto: s.nombre }]}
    variante="profundo"
  >
    <div class="portada__acciones">
      <BotonTurno
        mensaje={MENSAJES.servicio(s.nombreConsulta)}
        texto="Consultar por este servicio"
        variante="secundario"
        tamanio="lg"
      />
    </div>
  </PortadaPagina>

  {/* ===================== INTRODUCCION ===================== */}
  <section class="ckc-seccion ckc-seccion--corta">
    <div class="ckc-contenedor servicio">
      {/* --- Indice lateral --- */}
      <aside class="servicio__indice" data-animar>
        <nav aria-label="Secciones de esta página">
          <p class="servicio__indice-titulo">En esta página</p>
          <ol>
            {SECCIONES.map((sec) => (
              <li><a href={`#${sec.id}`}>{sec.texto}</a></li>
            ))}
          </ol>
        </nav>
      </aside>

      {/* --- Contenido --- */}
      <div class="servicio__cuerpo">
        <div class="ckc-prosa servicio__intro" data-animar>
          {s.introduccion.map((p) => <p>{p}</p>)}
        </div>

        <div class="servicio__visual" data-animar>
          <Visual
            src={foto ?? undefined}
            alt={foto ? TEXTOS_ALT[s.slug] : undefined}
            proporcion="16/9"
            motivo={s.motivo}
            tono={s.tono}
            rotulo={foto ? undefined : s.fotoSugerida}
            ancho={840}
          />
        </div>

        {/* --- 2. Descripcion --- */}
        <section class="servicio__seccion" id="descripcion">
          <h2>En qué consiste</h2>
          <div class="ckc-prosa">
            {s.descripcion.map((p) => <p>{p}</p>)}
          </div>
        </section>

        {/* --- 3. Situaciones --- */}
        <section class="servicio__seccion" id="situaciones">
          <h2>Situaciones en las que puede estar indicado</h2>
          <p class="servicio__nota">
            Esta lista es orientativa. Que tu situación aparezca acá no significa que
            necesites este tratamiento, y que no aparezca no significa lo contrario: la
            indicación surge de la evaluación.
          </p>
          <ul class="servicio__lista">
            {
              s.situaciones.map((item) => (
                <li>
                  <span class="servicio__lista-icono" aria-hidden="true">
                    <Icono nombre="objetivo" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </section>

        {/* --- 4. Objetivos --- */}
        <section class="servicio__seccion" id="objetivos">
          <h2>Objetivos generales del tratamiento</h2>
          <p class="servicio__nota">
            Los objetivos concretos se definen caso por caso. Estos son los que suelen
            plantearse en esta área.
          </p>
          <ul class="ckc-prosa servicio__objetivos">
            {s.objetivos.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        {/* --- 5. Evaluacion --- */}
        <section class="servicio__seccion" id="evaluacion">
          <h2>Cómo es la evaluación inicial</h2>
          <div class="ckc-prosa">
            {s.evaluacion.map((p) => <p>{p}</p>)}
          </div>
        </section>

        {/* --- 6. Proceso --- */}
        <section class="servicio__seccion" id="proceso">
          <h2>Qué puede incluir el proceso de tratamiento</h2>
          <div class="ckc-prosa">
            {s.proceso.map((p) => <p>{p}</p>)}
          </div>
        </section>

        {/* --- 7. Participacion --- */}
        <section class="servicio__seccion" id="participacion">
          <h2>Tu participación en el proceso</h2>
          <div class="ckc-prosa">
            {s.participacion.map((p) => <p>{p}</p>)}
          </div>
        </section>

        {/* --- Advertencia especifica del area --- */}
        {
          s.advertencia && (
            <aside class="servicio__advertencia">
              <span class="servicio__advertencia-icono" aria-hidden="true">
                <Icono nombre="documento" />
              </span>
              <p>{s.advertencia}</p>
            </aside>
          )
        }

        {/* --- 8. Preguntas frecuentes --- */}
        <section class="servicio__seccion" id="preguntas">
          <h2>Preguntas frecuentes sobre {s.nombre.toLowerCase()}</h2>
          <Acordeon preguntas={s.preguntas} />
          <p class="servicio__nota servicio__nota--pie">
            Hay más dudas respondidas en <a href="/preguntas-frecuentes/">las preguntas
            frecuentes del consultorio</a>, sobre turnos, coberturas y la primera consulta.
          </p>
        </section>

        {/* --- 9. Consulta --- */}
        <aside class="servicio__consulta">
          <h2>¿Querés saber si este abordaje es adecuado para tu caso?</h2>
          <p>
            Contanos tu motivo de consulta y te orientamos sobre los próximos pasos.
          </p>
          <BotonTurno
            mensaje={MENSAJES.servicio(s.nombreConsulta)}
            texto={`Consultar por ${s.nombre.toLowerCase()}`}
            tamanio="lg"
          />
        </aside>
      </div>
    </div>
  </section>

  {/* ===================== OTROS SERVICIOS ===================== */}
  <section class="ckc-seccion ckc-seccion--arena ckc-seccion--corta">
    <div class="ckc-contenedor">
      <h2 class="otros__titulo">Otras áreas de atención</h2>
      <ul class="otros">
        {
          otros.map((o, i) => (
            <li data-animar style={`--retardo:${i * 60}ms`}>
              <a href={`/servicios/${o.slug}/`}>
                <span class="otros__nombre">{o.nombre}</span>
                <span class="otros__flecha" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" focusable="false">
                    <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BandaCta
    titulo="Estamos para orientarte"
    texto="Si tenés dudas sobre si esta área corresponde a tu caso, escribinos y lo vemos."
    mensaje={MENSAJES.servicio(s.nombreConsulta)}
    textoBoton="Consultar por WhatsApp"
    secundario={{ texto: 'Ver todos los servicios', href: '/servicios/' }}
  />
</Base>

<style>
  .portada__acciones {
    margin-top: var(--ckc-esp-6);
  }

  /* --- Disposicion general ---------------------------------------------- */

  .servicio {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .servicio {
      grid-template-columns: 15rem 1fr;
    }
  }

  /* --- Indice lateral ---------------------------------------------------- */

  .servicio__indice {
    display: none;
  }

  @media (min-width: 64rem) {
    .servicio__indice {
      display: block;
      position: sticky;
      top: calc(var(--ckc-alto-encabezado) + 2rem);
    }
  }

  .servicio__indice-titulo {
    font-size: var(--ckc-txt-xs);
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ckc-tinta-suave);
    margin-bottom: var(--ckc-esp-4);
  }

  .servicio__indice ol {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 0.1rem;
    counter-reset: indice;
    border-left: 1px solid var(--ckc-linea);
  }

  .servicio__indice a {
    display: block;
    padding: 0.42rem 0 0.42rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: var(--ckc-txt-sm);
    color: var(--ckc-tinta-media);
    text-decoration: none;
    line-height: 1.45;
    transition: color var(--ckc-trans-rapida), border-color var(--ckc-trans-rapida);
  }

  .servicio__indice a:hover {
    color: var(--ckc-primario);
    border-left-color: var(--ckc-primario);
  }

  /* --- Contenido --------------------------------------------------------- */

  .servicio__cuerpo {
    min-width: 0;
  }

  .servicio__intro p {
    font-size: var(--ckc-txt-lg);
    line-height: 1.6;
    color: var(--ckc-tinta);
  }

  .servicio__visual {
    margin-top: var(--ckc-esp-7);
  }

  .servicio__seccion {
    margin-top: var(--ckc-esp-9);
    /* Deja aire al saltar desde el indice. */
    scroll-margin-top: calc(var(--ckc-alto-encabezado) + 2rem);
  }

  .servicio__seccion h2 {
    font-size: var(--ckc-txt-xl);
    margin-bottom: var(--ckc-esp-4);
    max-width: 30ch;
  }

  .servicio__nota {
    max-width: var(--ckc-ancho-texto);
    margin-bottom: var(--ckc-esp-5);
    padding-left: var(--ckc-esp-4);
    border-left: 2px solid color-mix(in srgb, var(--ckc-acento) 45%, transparent);
    font-size: var(--ckc-txt-sm);
    line-height: 1.6;
    color: var(--ckc-tinta-suave);
  }

  .servicio__nota--pie {
    margin-top: var(--ckc-esp-5);
    margin-bottom: 0;
  }

  /* --- Lista de situaciones --------------------------------------------- */

  .servicio__lista {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--ckc-esp-3);
  }

  .servicio__lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio);
    font-size: var(--ckc-txt-base);
    line-height: 1.6;
    color: var(--ckc-tinta-media);
  }

  .servicio__lista-icono {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.15rem;
    color: var(--ckc-acento);
  }

  .servicio__lista-icono :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 46rem) {
    .servicio__lista {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- Objetivos --------------------------------------------------------- */

  .servicio__objetivos {
    max-width: var(--ckc-ancho-texto);
  }

  /* --- Advertencia ------------------------------------------------------- */

  .servicio__advertencia {
    display: flex;
    gap: var(--ckc-esp-4);
    margin-top: var(--ckc-esp-8);
    padding: var(--ckc-esp-5);
    background: var(--ckc-aviso-fondo);
    border: 1px solid color-mix(in srgb, var(--ckc-aviso) 22%, transparent);
    border-radius: var(--ckc-radio-md);
  }

  .servicio__advertencia-icono {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.1rem;
    color: color-mix(in srgb, var(--ckc-aviso) 92%, #000);
  }

  .servicio__advertencia-icono :global(svg) {
    width: 100%;
    height: 100%;
  }

  .servicio__advertencia p {
    font-size: var(--ckc-txt-sm);
    line-height: 1.65;
    color: color-mix(in srgb, var(--ckc-aviso) 92%, #000);
  }

  /* --- Bloque de consulta ----------------------------------------------- */

  .servicio__consulta {
    margin-top: var(--ckc-esp-9);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--ckc-primario-claro);
    border-radius: var(--ckc-radio-md);
  }

  .servicio__consulta h2 {
    font-size: var(--ckc-txt-lg);
    margin-bottom: var(--ckc-esp-3);
    max-width: 32ch;
  }

  .servicio__consulta p {
    font-size: var(--ckc-txt-base);
    color: var(--ckc-tinta-media);
    margin-bottom: var(--ckc-esp-5);
    max-width: 44rem;
  }

  /* --- Otros servicios --------------------------------------------------- */

  .otros__titulo {
    font-size: var(--ckc-txt-xl);
    margin-bottom: var(--ckc-esp-6);
  }

  .otros {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--ckc-esp-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .otros a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--ckc-esp-4);
    height: 100%;
    padding: var(--ckc-esp-4) var(--ckc-esp-5);
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio-md);
    text-decoration: none;
    transition:
      border-color var(--ckc-trans),
      box-shadow var(--ckc-trans),
      translate var(--ckc-trans);
  }

  .otros a:hover {
    border-color: color-mix(in srgb, var(--ckc-primario) 30%, transparent);
    box-shadow: var(--ckc-sombra);
    translate: 0 -2px;
  }

  .otros__nombre {
    display: block;
    font-family: var(--ckc-fuente-titulo);
    font-size: var(--ckc-txt-base);
    line-height: 1.35;
    color: var(--ckc-primario-oscuro);
  }

  .otros__flecha {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--ckc-linea);
    color: var(--ckc-primario);
    transition: background-color var(--ckc-trans), translate var(--ckc-trans);
  }

  .otros__flecha svg {
    width: 1rem;
    height: 1rem;
  }

  .otros a:hover .otros__flecha {
    background: var(--ckc-primario-claro);
    translate: 3px 0;
  }
</style>

<script>
  // Marca en el indice lateral la seccion que se esta leyendo.
  const enlaces = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.servicio__indice a'),
  );

  if (enlaces.length > 0 && 'IntersectionObserver' in window) {
    const secciones = enlaces
      .map((a) => document.querySelector(a.hash))
      .filter((el): el is Element => el !== null);

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          const id = entrada.target.id;
          enlaces.forEach((a) => {
            const activo = a.hash === `#${id}`;
            a.style.color = activo ? 'var(--ckc-primario)' : '';
            a.style.borderLeftColor = activo ? 'var(--ckc-primario)' : '';
            a.style.fontWeight = activo ? '650' : '';
          });
        });
      },
      { rootMargin: '-25% 0px -65% 0px' },
    );

    secciones.forEach((s) => observador.observe(s));
  }
</script>
