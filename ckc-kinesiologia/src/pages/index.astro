---
/**
 * LANDING DE CKC — página única.
 *
 * Estructura portada del sitio de referencia que indicó el cliente: barra
 * superior de contacto, hero con cifras incrustadas, grilla de servicios, un
 * área destacada, quiénes somos, instalaciones, equipo y bloque de turnos.
 *
 * El contenido es solo el que CKC tiene confirmado. Los bloques de la
 * referencia que no aplican —metros cuadrados, unidades móviles, servicios
 * que CKC no ofrece— quedaron afuera en lugar de rellenarse.
 */
import Base from '@/layouts/Base.astro';
import Boton from '@/components/Boton.astro';
import BotonTurno from '@/components/BotonTurno.astro';
import TituloSeccion from '@/components/TituloSeccion.astro';
import TarjetaServicio from '@/components/TarjetaServicio.astro';
import MotivosConsulta from '@/components/MotivosConsulta.astro';
import TarjetaRasgo from '@/components/TarjetaRasgo.astro';
import FichaProfesional from '@/components/FichaProfesional.astro';
import MuroInstituciones from '@/components/MuroInstituciones.astro';
import Galeria from '@/components/Galeria.astro';
import Acordeon from '@/components/Acordeon.astro';
import Formulario from '@/components/Formulario.astro';
import Visual from '@/components/Visual.astro';
import Icono from '@/components/Icono.astro';
import AvisoPendiente from '@/components/AvisoPendiente.astro';

import { SERVICIOS, servicioPorSlug } from '@/data/servicios';
import { PREGUNTAS } from '@/data/preguntas';
import { PROFESIONALES, hayEquipoCargado } from '@/data/equipo';
import { GALERIA, hayFotosPropias } from '@/data/instalaciones';
import { CIFRAS, anioInicio } from '@/data/trayectoria';
import { FOTOS, TEXTOS_ALT } from '@/data/fotos';
import {
  MENSAJES,
  CONTACTO,
  UBICACION,
  HORARIOS,
  hayWhatsApp,
  hayTelefono,
  hayDireccion,
  hayHorarios,
  direccionEnLinea,
} from '@/data/site';
import { SITE } from '@/data/site-url.mjs';

const mep = servicioPorSlug('mep')!;
const otrosServicios = SERVICIOS.filter((s) => s.slug !== 'mep');

/** Cifras del hero: solo las tres que tienen sentido ahí arriba. */
const cifrasHero = CIFRAS.filter((c) => ['anios', 'areas', 'clubes'].includes(c.id));

const DIFERENCIALES = [
  {
    icono: 'evaluacion' as const,
    titulo: 'Evaluamos antes de tratar',
    texto:
      'Ningún tratamiento arranca sin entender el caso. Si hace falta una consulta médica primero, te lo decimos.',
  },
  {
    icono: 'movimiento' as const,
    titulo: 'Perfil deportivo',
    texto:
      'Trabajamos el gesto deportivo, la vuelta progresiva a entrenar y la prevención de recaídas.',
  },
  {
    icono: 'objetivo' as const,
    titulo: 'Objetivos concretos',
    texto:
      'El plan se arma sobre lo que querés volver a hacer, y se revisa a medida que avanzás.',
  },
  {
    icono: 'dialogo' as const,
    titulo: 'Explicaciones claras',
    texto:
      'Te contamos qué encontramos y por qué hacemos lo que hacemos, sin tecnicismos innecesarios.',
  },
  {
    icono: 'casa' as const,
    titulo: 'Seguís en casa',
    texto:
      'Pautas realistas para sostener el trabajo entre sesiones, pensadas para tu rutina.',
  },
  {
    icono: 'acompanamiento' as const,
    titulo: 'Acompañamiento del proceso',
    texto:
      'Revisamos la evolución y ajustamos el plan. Un tratamiento que no se revisa deja de adaptarse.',
  },
];

const limpiar = (s: string) =>
  s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
---

<Base
  titulo="CKC Kinesiología — Consultorio Kinésico Canning"
  descripcion="Consultorio kinésico en Canning: kinesiología deportiva, lesiones, prevención de caídas, suelo pélvico y MEP. Evaluamos tu caso y definimos un plan. Sacá tu turno."
  esquemas={[
    {
      '@type': 'FAQPage',
      mainEntity: PREGUNTAS.map((p) => ({
        '@type': 'Question',
        name: p.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: p.respuesta.map(limpiar).join(' ') },
      })),
    },
    {
      '@type': 'ItemList',
      name: 'Áreas de atención de CKC Kinesiología',
      itemListElement: SERVICIOS.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.nombre,
        url: `${SITE}/#servicio-${s.slug}`,
      })),
    },
  ]}
>
  {/* ============================ HERO ============================ */}
  <section class="hero">
    <div class="hero__fondo" aria-hidden="true">
      <svg viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" fill="none">
        <defs>
          <radialGradient id="h-luz" cx="0.76" cy="0.26" r="0.78">
            <stop offset="0%" stop-color="#2f9a58" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#0d3b23" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="1200" height="900" fill="#0d3b23" />
        <rect width="1200" height="900" fill="url(#h-luz)" />
        <g class="hero__arcos">
          <circle cx="950" cy="330" r="340" />
          <circle cx="950" cy="330" r="252" />
          <circle cx="950" cy="330" r="164" class="hero__arco--vivo" />
          <path d="M-60 820C250 820 330 330 610 330s250 350 700 200" />
        </g>
      </svg>
    </div>

    <div class="ckc-contenedor hero__interior">
      <div class="hero__texto">
        <p class="hero__rotulo">Consultorio kinésico · Canning</p>

        <h1 class="hero__titulo">
          Miramos cada caso <em>en particular</em>, no el promedio.
        </h1>

        <p class="hero__bajada">
          Kinesiología deportiva, lesiones, prevención de caídas, suelo pélvico y MEP.
          Cinco áreas con un mismo punto de partida: entender qué te pasa antes de
          proponerte un tratamiento.
        </p>

        <div class="hero__acciones">
          <BotonTurno
            mensaje={MENSAJES.turno}
            texto="Escribinos por WhatsApp"
            variante="secundario"
            tamanio="lg"
          />
          <Boton href="#servicios" variante="claro" tamanio="lg" flecha>
            Ver nuestros servicios
          </Boton>
        </div>

        {/* --- Cifras incrustadas, como en la referencia --- */}
        <ul class="hero__cifras">
          {
            cifrasHero.map((c) => (
              <li>
                <span class:list={['hero__cifra', !c.valor && 'hero__cifra--vacia']}>
                  {c.id === 'anios' && anioInicio ? anioInicio : (c.valor ?? '—')}
                </span>
                <span class="hero__cifra-etiqueta">
                  {c.id === 'anios' ? 'Desde' : c.etiqueta}
                  {!c.valor && <span class="hero__pendiente">a confirmar</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__visual">
        <Visual
          src={FOTOS.hero ?? undefined}
          alt={FOTOS.hero ? TEXTOS_ALT.hero : undefined}
          proporcion="4/5"
          motivo="arcos"
          tono="profundo"
          rotulo={FOTOS.hero ? undefined : 'Foto a incorporar: sesión de tratamiento en el consultorio'}
          prioridad
          ancho={620}
        />
      </div>
    </div>
  </section>

  {/* ============================ SERVICIOS ============================ */}
  <section class="ckc-seccion" id="servicios">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Nuestros servicios"
        titulo="Un abordaje integral para cada consulta"
        bajada="Cinco áreas en un mismo consultorio. Tocá cualquiera para ver en qué consiste y qué busca el tratamiento."
      />

      <div class="grilla-servicios">
        {otrosServicios.map((s, i) => <TarjetaServicio servicio={s} retardo={i * 60} />)}
      </div>
    </div>
  </section>

  {/* ========================= ÁREA DESTACADA: MEP ========================= */}
  <section class="ckc-seccion destacada" id="mep">
    <div class="ckc-contenedor destacada__interior">
      <div class="destacada__texto" data-animar>
        <p class="ckc-rotulo">Área destacada</p>
        <h2>{mep.nombre}, en sus líneas Sport y Beauty</h2>
        <p class="destacada__entrada">{mep.resumen}</p>

        <div class="destacada__bloques">
          <div>
            <p class="destacada__rotulo">¿Para quién?</p>
            <ul>
              {mep.situaciones.slice(0, 3).map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div>
            <p class="destacada__rotulo">Cómo se decide</p>
            <p class="destacada__parrafo">{mep.evaluacion[0]}</p>
          </div>
        </div>

        {mep.advertencia && <p class="destacada__aviso">{mep.advertencia}</p>}

        <div class="destacada__accion">
          <BotonTurno
            mensaje={MENSAJES.servicio(mep.nombreConsulta)}
            texto="Consultar por MEP"
            tamanio="lg"
          />
        </div>
      </div>

      <div class="destacada__visual" data-animar style="--retardo:110ms">
        <Visual
          proporcion="4/5"
          motivo={mep.motivo}
          tono="profundo"
          rotulo={mep.fotoSugerida}
          ancho={540}
        />
      </div>
    </div>
  </section>

  {/* ============================ MOTIVOS ============================ */}
  <section class="ckc-seccion ckc-seccion--arena" id="motivos">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Empezá por acá"
        titulo="Buscá por lo que te pasa"
        bajada="No hace falta que sepas el nombre del tratamiento. Entrá por el motivo que te trae y te contamos cómo lo abordamos."
      />
      <MotivosConsulta sobre="arena" />
    </div>
  </section>

  {/* ============================ NOSOTROS ============================ */}
  <section class="ckc-seccion" id="nosotros">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Quiénes somos"
        titulo="Una mirada que nos hace distintos"
        bajada="No vamos a decirte que tenemos la mejor tecnología ni que te vas a curar en un número de sesiones. Preferimos contarte cómo trabajamos."
      />

      <div class="ckc-grilla ckc-grilla--3">
        {
          DIFERENCIALES.map((d, i) => (
            <TarjetaRasgo icono={d.icono} titulo={d.titulo} texto={d.texto} retardo={i * 55} />
          ))
        }
      </div>

      {
        !anioInicio && (
          <AvisoPendiente
            titulo="Trayectoria a confirmar"
            campo="src/data/trayectoria.ts → anioInicio, CIFRAS, INSTITUCIONES"
            class="nosotros__aviso"
          >
            <p>
              El año de inicio, la cantidad de clubes y los deportistas acompañados los
              tiene que confirmar el consultorio. En cuanto estén cargados aparecen en el
              hero y acá, y los años se recalculan solos cada enero.
            </p>
          </AvisoPendiente>
        )
      }
    </div>
  </section>

  {/* ========================= INSTITUCIONES ========================= */}
  <section class="ckc-seccion ckc-seccion--arena" id="instituciones">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Con quiénes trabajamos"
        titulo="Clubes, instituciones y equipos"
        bajada="Buena parte de nuestro trabajo pasa por la cancha y el gimnasio: acompañamos planteles, escuelas deportivas y deportistas que compiten."
      />
      <MuroInstituciones />
    </div>
  </section>

  {/* ========================= INSTALACIONES ========================= */}
  <section class="ckc-seccion" id="instalaciones">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Nuestras instalaciones"
        titulo="El espacio donde atendemos"
        bajada="Conocer el lugar antes de ir hace más fácil la primera consulta, sobre todo si es tu primer tratamiento kinésico."
      />

      {
        !hayFotosPropias && (
          <AvisoPendiente
            titulo="Fotografías del consultorio pendientes"
            campo="src/data/instalaciones.ts → GALERIA"
            class="galeria__aviso"
          >
            <p>
              No usamos imágenes de otros centros ni fotos genéricas que puedan hacerse
              pasar por este consultorio. Cada casillero indica qué fotografía
              corresponde en ese lugar.
            </p>
          </AvisoPendiente>
        )
      }

      <Galeria items={GALERIA} />
    </div>
  </section>

  {/* ============================ EQUIPO ============================ */}
  <section class="ckc-seccion ckc-seccion--arena" id="equipo">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Equipo"
        titulo="Quién te va a atender"
        bajada="La kinesiología es trabajo de contacto y de confianza. Saber quién te atiende es parte de eso."
      />

      {
        !hayEquipoCargado && (
          <AvisoPendiente
            titulo="Datos del equipo pendientes"
            campo="src/data/equipo.ts → PROFESIONALES"
            class="equipo__aviso"
          >
            <p>
              No publicamos nombres ni matrículas sin verificarlos: son credenciales
              sanitarias. Las fichas muestran la estructura final, lista para completar.
            </p>
          </AvisoPendiente>
        )
      }

      <div class="ckc-grilla ckc-grilla--2 equipo__grilla">
        {PROFESIONALES.map((p, i) => <FichaProfesional profesional={p} retardo={i * 80} />)}
      </div>
    </div>
  </section>

  {/* ============================ PREGUNTAS ============================ */}
  <section class="ckc-seccion" id="preguntas">
    <div class="ckc-contenedor preguntas">
      <div class="preguntas__texto" data-animar>
        <p class="ckc-rotulo">Preguntas frecuentes</p>
        <h2>Las dudas que aparecen antes de consultar</h2>
        <p class="ckc-bajada">
          Donde la respuesta depende de algo administrativo que todavía tenemos que
          confirmar, lo decimos en lugar de inventar un dato.
        </p>
        <div class="preguntas__accion">
          <BotonTurno mensaje={MENSAJES.general} texto="Hacer otra consulta" variante="contorno" />
        </div>
      </div>

      <div class="preguntas__lista">
        <Acordeon preguntas={PREGUNTAS} />
      </div>
    </div>
  </section>

  {/* ============================ TURNOS ============================ */}
  <section class="ckc-seccion turnos" id="turnos">
    <div class="ckc-contenedor">
      <div class="turnos__encabezado" data-animar>
        <p class="ckc-rotulo">Turnos</p>
        <h2>Sacá tu turno</h2>
        <p class="turnos__bajada">
          Contanos tu motivo de consulta y te orientamos sobre los próximos pasos. Si
          hace falta una evaluación, coordinamos el turno.
        </p>
      </div>

      <div class="turnos__cuerpo">
        {/* --- Canales --- */}
        <div class="turnos__canales" data-animar>
          <h3 class="turnos__subtitulo">¿Preferís resolverlo al instante?</h3>

          <ul class="turnos__datos">
            <li>
              <span class="turnos__icono" aria-hidden="true"><Icono nombre="dialogo" /></span>
              <span>
                <strong>WhatsApp</strong>
                {
                  hayWhatsApp ? (
                    <span>La vía más rápida para coordinar un turno.</span>
                  ) : (
                    <span>
                      Pendiente de confirmación. No publicamos un número sin verificar
                      para que nadie escriba a un destinatario equivocado.
                    </span>
                  )
                }
              </span>
            </li>

            <li>
              <span class="turnos__icono" aria-hidden="true"><Icono nombre="persona" /></span>
              <span>
                <strong>Instagram</strong>
                <a href={CONTACTO.instagram.url} target="_blank" rel="noopener noreferrer">
                  {CONTACTO.instagram.usuario}
                </a>
                <span>Nuestro canal activo.</span>
              </span>
            </li>

            <li>
              <span class="turnos__icono" aria-hidden="true"><Icono nombre="ubicacion" /></span>
              <span>
                <strong>Dónde estamos</strong>
                <span>
                  {
                    hayDireccion && direccionEnLinea
                      ? direccionEnLinea
                      : `${UBICACION.resumen}. Dirección exacta a confirmar: escribinos y te la pasamos.`
                  }
                </span>
              </span>
            </li>

            <li>
              <span class="turnos__icono" aria-hidden="true"><Icono nombre="tiempo" /></span>
              <span>
                <strong>Horarios</strong>
                {
                  hayHorarios && HORARIOS.lista ? (
                    <span>
                      {HORARIOS.lista.map((h) => (
                        <span class="turnos__horario">
                          {h.dias}: {h.franjas.join(' y ')}
                        </span>
                      ))}
                    </span>
                  ) : (
                    <span>A confirmar. Consultanos la disponibilidad actual.</span>
                  )
                }
              </span>
            </li>

            {
              hayTelefono && CONTACTO.telefono && (
                <li>
                  <span class="turnos__icono" aria-hidden="true"><Icono nombre="calendario" /></span>
                  <span>
                    <strong>Teléfono</strong>
                    <a href={`tel:+${CONTACTO.telefono.link}`}>{CONTACTO.telefono.display}</a>
                  </span>
                </li>
              )
            }
          </ul>

          <div class="turnos__cta">
            <BotonTurno mensaje={MENSAJES.turno} texto="Sacá tu turno" tamanio="lg" ancho />
          </div>
        </div>

        {/* --- Formulario --- */}
        <div class="turnos__formulario" data-animar style="--retardo:110ms">
          <h3 class="turnos__subtitulo">Escribinos</h3>
          <Formulario />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ============================ HERO ============================ */

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ckc-verde-900);
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__fondo svg {
    width: 100%;
    height: 100%;
  }

  .hero__arcos circle,
  .hero__arcos path {
    fill: none;
    stroke: color-mix(in srgb, #ffffff 15%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero__arco--vivo {
    stroke: color-mix(in srgb, var(--ckc-ambar-400) 65%, transparent) !important;
    stroke-width: 1.6 !important;
  }

  .hero__interior {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero__interior {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  @media (max-width: 46rem) {
    .hero__visual {
      display: none;
    }
  }

  .hero__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--ckc-txt-xs);
    font-weight: var(--ckc-peso-fuerte);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ckc-ambar-400);
  }

  .hero__rotulo::before {
    content: '';
    width: 2rem;
    height: 2px;
    background: var(--ckc-ambar-500);
  }

  .hero__titulo {
    margin-top: var(--ckc-esp-5);
    font-size: var(--ckc-txt-4xl);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--ckc-blanco);
    max-width: 15ch;
  }

  .hero__titulo em {
    font-style: normal;
    color: var(--ckc-ambar-400);
  }

  .hero__bajada {
    margin-top: var(--ckc-esp-6);
    max-width: 38rem;
    font-size: var(--ckc-txt-md);
    line-height: 1.6;
    color: color-mix(in srgb, #ffffff 80%, var(--ckc-verde-500));
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ckc-esp-4);
    margin-top: var(--ckc-esp-7);
  }

  .hero__cifras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ckc-esp-7);
    list-style: none;
    margin: var(--ckc-esp-8) 0 0;
    padding-top: var(--ckc-esp-6);
    border-top: 1px solid color-mix(in srgb, #ffffff 16%, transparent);
  }

  .hero__cifra {
    display: block;
    font-size: var(--ckc-txt-cifra);
    font-weight: var(--ckc-peso-titulo);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ckc-blanco);
    font-variant-numeric: tabular-nums;
  }

  .hero__cifra--vacia {
    opacity: 0.45;
  }

  .hero__cifra-etiqueta {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--ckc-txt-sm);
    font-weight: 500;
    color: color-mix(in srgb, #ffffff 76%, var(--ckc-verde-500));
    max-width: 11rem;
  }

  .hero__pendiente {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.68rem;
    font-weight: var(--ckc-peso-fuerte);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, #ffffff 55%, transparent);
  }

  /* ============================ SERVICIOS ============================ */

  .grilla-servicios {
    display: grid;
    gap: var(--ckc-esp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }

  /* ========================= ÁREA DESTACADA ========================= */

  .destacada {
    background: var(--ckc-verde-900);
    color: color-mix(in srgb, #ffffff 84%, var(--ckc-verde-500));
    scroll-margin-top: calc(var(--ckc-alto-encabezado) + 1rem);
  }

  .destacada__interior {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .destacada__interior {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .destacada :global(.ckc-rotulo) {
    color: var(--ckc-ambar-400);
  }

  .destacada h2 {
    color: var(--ckc-blanco);
    font-size: var(--ckc-txt-2xl);
    max-width: 20ch;
  }

  .destacada__entrada {
    margin-top: var(--ckc-esp-5);
    max-width: 40rem;
    font-size: var(--ckc-txt-md);
    line-height: 1.65;
  }

