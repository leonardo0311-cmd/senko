---
import Base from '@/layouts/Base.astro';
import Boton from '@/components/Boton.astro';
import BotonTurno from '@/components/BotonTurno.astro';
import TituloSeccion from '@/components/TituloSeccion.astro';
import TarjetaServicio from '@/components/TarjetaServicio.astro';
import TarjetaRasgo from '@/components/TarjetaRasgo.astro';
import FichaProfesional from '@/components/FichaProfesional.astro';
import FranjaCifras from '@/components/FranjaCifras.astro';
import MuroInstituciones from '@/components/MuroInstituciones.astro';
import BandaCta from '@/components/BandaCta.astro';
import TarjetaNota from '@/components/TarjetaNota.astro';
import AvisoPendiente from '@/components/AvisoPendiente.astro';
import { SERVICIOS } from '@/data/servicios';
import { PROFESIONALES, hayEquipoCargado } from '@/data/equipo';
import { afirmacionDeEscala, respaldo, aniosDeTrayectoria } from '@/data/trayectoria';
import { MENSAJES, CONTACTO } from '@/data/site';
import { getCollection } from 'astro:content';

const notas = (await getCollection('blog'))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

/* Cuatro diferenciales, no seis: menos lista, más peso en cada uno. */
const DIFERENCIALES = [
  {
    icono: 'evaluacion' as const,
    titulo: 'Evaluamos antes de tratar',
    texto:
      'Ningún tratamiento arranca sin entender el caso. Si hace falta una consulta médica primero, te lo decimos.',
  },
  {
    icono: 'movimiento' as const,
    titulo: 'Perfil deportivo',
    texto:
      'Trabajamos el gesto deportivo, la vuelta progresiva a entrenar y la prevención de recaídas.',
  },
  {
    icono: 'objetivo' as const,
    titulo: 'Objetivos concretos',
    texto:
      'El plan se arma sobre lo que querés volver a hacer, y se revisa a medida que avanzás.',
  },
  {
    icono: 'casa' as const,
    titulo: 'Seguís en casa',
    texto:
      'Pautas realistas para sostener el trabajo entre sesiones, pensadas para tu rutina.',
  },
];
---

<Base
  titulo="CKC Kinesiología | Consultorio kinésico en Canning"
  descripcion="Consultorio kinésico en Canning: kinesiología deportiva, lesiones, prevención de caídas, suelo pélvico y MEP. Evaluamos tu caso y definimos un plan. Consultanos."
>
  {/* ============================ HERO ============================ */}
  <section class="hero">
    <div class="hero__fondo" aria-hidden="true">
      <svg viewBox="0 0 1200 820" preserveAspectRatio="xMidYMid slice" fill="none">
        <defs>
          <radialGradient id="h-brillo" cx="0.78" cy="0.3" r="0.72">
            <stop offset="0%" stop-color="#158174" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#06302c" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="1200" height="820" fill="#06302c" />
        <rect width="1200" height="820" fill="url(#h-brillo)" />
        <g class="hero__arcos">
          <circle cx="945" cy="340" r="330" />
          <circle cx="945" cy="340" r="248" />
          <circle cx="945" cy="340" r="166" class="hero__arco--vivo" />
          <circle cx="945" cy="340" r="84" />
          <path d="M-60 760C250 760 330 300 600 300s250 330 700 190" />
          <path d="M-60 812C250 812 330 352 600 352s250 330 700 190" class="hero__arco--punteado" />
        </g>
      </svg>
    </div>

    <div class="ckc-contenedor hero__interior">
      <p class="hero__rotulo">Consultorio Kinésico Canning</p>

      <h1 class="hero__titulo">
        Recuperá tu movimiento.<br />
        <em>Volvé a sentirte bien.</em>
      </h1>

      <p class="hero__bajada">
        Kinesiología deportiva, lesiones, prevención de caídas, suelo pélvico y MEP.
        Cinco áreas, un mismo punto de partida: entender tu caso antes de proponerte
        un tratamiento.
      </p>

      <div class="hero__acciones">
        <BotonTurno
          mensaje={MENSAJES.turno}
          texto="Solicitar un turno"
          variante="secundario"
          tamanio="lg"
        />
        <Boton href="#servicios" variante="claro" tamanio="lg" flecha>
          Ver los servicios
        </Boton>
      </div>

      <ul class="hero__areas">
        {
          SERVICIOS.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}/`}>{s.nombre}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ========================= CIFRAS ========================= */}
  <FranjaCifras variante="clara" />

  {/* ===================== CLUBES E INSTITUCIONES ===================== */}
  <section class="ckc-seccion ckc-seccion--blanca" id="instituciones">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Con quiénes trabajamos"
        titulo="Clubes, instituciones y equipos"
        bajada="Buena parte de nuestro trabajo pasa por la cancha y el gimnasio: acompañamos planteles, escuelas deportivas y deportistas que compiten."
      />
      <MuroInstituciones />
    </div>
  </section>

  {/* ========================= SERVICIOS ========================= */}
  <section class="ckc-seccion ckc-seccion--arena" id="servicios">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Servicios"
        titulo="Cinco áreas, un solo consultorio"
        bajada="No hace falta ir a un lugar distinto por cada cosa. Estas son las áreas con las que trabajamos, cada una con su página."
      />

      <div class="ckc-grilla ckc-grilla--3">
        {SERVICIOS.map((s, i) => <TarjetaServicio servicio={s} retardo={i * 60} />)}
      </div>

      <div class="cierre-servicios" data-animar>
        <p>¿No sabés a qué área corresponde tu caso? Contanos qué te pasa y te orientamos.</p>
        <BotonTurno mensaje={MENSAJES.general} texto="Consultar mi caso" />
      </div>
    </div>
  </section>

  {/* ========================= DIFERENCIALES ========================= */}
  <section class="ckc-seccion">
    <div class="ckc-contenedor diferenciales">
      <div class="diferenciales__texto" data-animar>
        <p class="ckc-rotulo">Cómo atendemos</p>
        <h2>
          Sin promesas. <em>Con criterio.</em>
        </h2>
        <p class="ckc-bajada">
          No vamos a decirte que tenemos la mejor tecnología ni que te vas a curar en
          un número de sesiones. Preferimos contarte cómo trabajamos, que es lo que
          podés esperar de verdad.
        </p>
        <Boton href="/como-trabajamos/" variante="contorno" flecha class="diferenciales__boton">
          Ver el proceso completo
        </Boton>
      </div>

      <div class="diferenciales__grilla">
        {
          DIFERENCIALES.map((d, i) => (
            <TarjetaRasgo
              icono={d.icono}
              titulo={d.titulo}
              texto={d.texto}
              retardo={i * 60}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ========================= TRAYECTORIA ========================= */}
  <section class="ckc-seccion ckc-seccion--oscura trayectoria">
    <div class="ckc-contenedor trayectoria__interior">
      <div data-animar>
        <p class="ckc-rotulo">Trayectoria</p>
        <h2 class="trayectoria__titulo">
          {
            afirmacionDeEscala
              ? afirmacionDeEscala
              : aniosDeTrayectoria
                ? `${aniosDeTrayectoria} años atendiendo en Canning`
                : 'Kinesiología en Canning, de la cancha al consultorio'
          }
        </h2>
        <p class="trayectoria__texto">
          {
            respaldo
              ? respaldo
              : 'Atendemos a deportistas, a personas que se están recuperando de una lesión o una cirugía, a adultos mayores que quieren moverse con seguridad y a consultas de suelo pélvico. Cinco áreas bajo el mismo techo, en Canning.'
          }
        </p>

        <div class="trayectoria__acciones">
          <Boton href="/nosotros/" variante="claro" flecha>Conocé el consultorio</Boton>
          <Boton href={CONTACTO.instagram.url} variante="texto" class="trayectoria__ig">
            Mirá nuestro día a día en Instagram
          </Boton>
        </div>
      </div>

      <AvisoPendiente
        titulo="Años y cifras a confirmar"
        campo="src/data/trayectoria.ts → anioInicio, CIFRAS, INSTITUCIONES"
        tono="neutro"
        class="trayectoria__aviso"
      >
        <p>
          El año de inicio, la cantidad de clubes y los deportistas acompañados los
          tiene que confirmar el consultorio. En cuanto estén cargados, aparecen acá,
          en la franja de cifras y en Nosotros, y los años se recalculan solos cada
          enero.
        </p>
      </AvisoPendiente>
    </div>
  </section>

  {/* ========================= EQUIPO ========================= */}
  <section class="ckc-seccion ckc-seccion--blanca">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Equipo"
        titulo="Quién te va a atender"
        bajada="La kinesiología es trabajo de contacto y de confianza. Saber quién te atiende es parte de eso."
      />

      {
        !hayEquipoCargado && (
          <AvisoPendiente
            titulo="Datos del equipo pendientes"
            campo="src/data/equipo.ts → PROFESIONALES"
            class="equipo__aviso"
          >
            <p>
              No publicamos nombres ni matrículas sin verificarlos: son credenciales
              sanitarias. Las fichas muestran la estructura final, lista para completar.
            </p>
          </AvisoPendiente>
        )
      }

      <div class="ckc-grilla ckc-grilla--2 equipo__grilla">
        {PROFESIONALES.map((p, i) => <FichaProfesional profesional={p} retardo={i * 80} />)}
      </div>

      <div class="centrado-pie" data-animar>
        <Boton href="/profesionales/" variante="contorno" flecha>Ver el equipo completo</Boton>
      </div>
    </div>
  </section>

  {/* ========================= BLOG ========================= */}
  <section class="ckc-seccion ckc-seccion--arena">
    <div class="ckc-contenedor">
      <TituloSeccion
        rotulo="Blog"
        titulo="Salud, movimiento y prevención"
        bajada="Información general para entender mejor el cuerpo y qué esperar de un tratamiento. No reemplaza una consulta."
      />

      <div class="ckc-grilla ckc-grilla--3">
        {notas.map((nota, i) => <TarjetaNota nota={nota} retardo={i * 60} />)}
      </div>

      <div class="centrado-pie" data-animar>
        <Boton href="/blog/" variante="contorno" flecha>Ver todas las notas</Boton>
      </div>
    </div>
  </section>

  <BandaCta
    titulo="¿Querés saber qué tratamiento puede ayudarte?"
    texto="Contanos tu motivo de consulta y vemos juntos los próximos pasos."
    mensaje={MENSAJES.general}
    textoBoton="Escribinos por WhatsApp"
    secundario={{ texto: 'Ver preguntas frecuentes', href: '/preguntas-frecuentes/' }}
  />
</Base>

<style>
  /* ============================ HERO ============================ */

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ckc-primario-oscuro);
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__fondo svg {
    width: 100%;
    height: 100%;
  }

  .hero__arcos circle,
  .hero__arcos path {
    fill: none;
    stroke: color-mix(in srgb, #ffffff 16%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero__arco--vivo {
    stroke: color-mix(in srgb, var(--ckc-acento-vivo) 62%, transparent) !important;
    stroke-width: 1.6 !important;
  }

  .hero__arco--punteado {
    stroke-dasharray: 5 10;
    opacity: 0.7;
  }

  .hero__interior {
    position: relative;
    z-index: 1;
    max-width: 60rem;
  }

  .hero__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--ckc-txt-xs);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ckc-acento-vivo) 80%, #ffffff);
  }

  .hero__rotulo::before {
    content: '';
    width: 2rem;
    height: 2px;
    background: var(--ckc-acento-vivo);
  }

  .hero__titulo {
    margin-top: var(--ckc-esp-5);
    font-size: var(--ckc-txt-4xl);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--ckc-blanco);
    max-width: 16ch;
  }

  .hero__titulo em {
    font-style: italic;
    color: color-mix(in srgb, var(--ckc-acento-vivo) 72%, #ffffff);
  }

  .hero__bajada {
    margin-top: var(--ckc-esp-6);
    max-width: 40rem;
    font-size: var(--ckc-txt-md);
    line-height: 1.6;
    color: color-mix(in srgb, #ffffff 78%, var(--ckc-primario));
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ckc-esp-4);
    margin-top: var(--ckc-esp-7);
  }

  .hero__areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: var(--ckc-esp-8) 0 0;
    padding-top: var(--ckc-esp-5);
    border-top: 1px solid color-mix(in srgb, #ffffff 15%, transparent);
  }

  .hero__areas a {
    display: inline-block;
    padding: 0.42rem 0.9rem;
    border: 1px solid color-mix(in srgb, #ffffff 22%, transparent);
    border-radius: var(--ckc-radio-pastilla);
    font-size: var(--ckc-txt-xs);
    font-weight: 600;
    color: color-mix(in srgb, #ffffff 86%, transparent);
    text-decoration: none;
    transition: background-color var(--ckc-trans), border-color var(--ckc-trans);
  }

  .hero__areas a:hover {
    background: color-mix(in srgb, #ffffff 12%, transparent);
    border-color: color-mix(in srgb, #ffffff 46%, transparent);
    color: var(--ckc-blanco);
  }

  /* ========================= SERVICIOS ========================= */

  .cierre-servicios {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ckc-esp-5);
    margin-top: var(--ckc-esp-7);
    padding: var(--ckc-esp-5) var(--ckc-esp-6);
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio-md);
  }

  .cierre-servicios p {
    max-width: 42rem;
    font-size: var(--ckc-txt-base);
    color: var(--ckc-tinta-media);
  }

  /* ========================= DIFERENCIALES ========================= */

  .diferenciales {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .diferenciales {
      grid-template-columns: 22rem 1fr;
    }

    .diferenciales__texto {
      position: sticky;
      top: calc(var(--ckc-alto-encabezado) + 2rem);
    }
  }

  .diferenciales__texto h2 {
    font-size: var(--ckc-txt-2xl);
    max-width: 14ch;
  }

  .diferenciales__texto h2 em {
    font-style: italic;
    color: var(--ckc-primario);
  }

  .diferenciales__grilla {
    display: grid;
    gap: var(--ckc-esp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  /* ========================= TRAYECTORIA ========================= */

  .trayectoria {
    position: relative;
    overflow: hidden;
  }

  .trayectoria__interior {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .trayectoria__interior {
      grid-template-columns: 1fr 22rem;
    }
  }

  .trayectoria__titulo {
    margin-top: var(--ckc-esp-4);
    font-size: var(--ckc-txt-2xl);
    max-width: 18ch;
  }

  .trayectoria__texto {
    margin-top: var(--ckc-esp-5);
    max-width: 42rem;
    font-size: var(--ckc-txt-md);
    line-height: 1.65;
    color: color-mix(in srgb, #ffffff 76%, var(--ckc-primario));
  }

  .trayectoria__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ckc-esp-4);
    margin-top: var(--ckc-esp-6);
  }

  :global(.trayectoria__ig) {
    color: color-mix(in srgb, #ffffff 84%, transparent);
  }

  /* ========================= COMUNES ========================= */

  /* Estas clases viajan a la raíz de otro componente (<Boton>,
     <AvisoPendiente>), adonde los estilos con alcance no llegan. */
  :global(.diferenciales__boton) {
    margin-top: var(--ckc-esp-5);
  }

  :global(.trayectoria__aviso) {
    background: color-mix(in srgb, #ffffff 9%, transparent) !important;
    border-color: color-mix(in srgb, #ffffff 18%, transparent) !important;
    color: color-mix(in srgb, #ffffff 80%, transparent) !important;
  }

  :global(.equipo__aviso) {
    margin-bottom: var(--ckc-esp-6);
  }

  .equipo__grilla {
    gap: var(--ckc-esp-5);
  }

  .centrado-pie {
    display: flex;
    justify-content: center;
    margin-top: var(--ckc-esp-7);
  }
</style>
