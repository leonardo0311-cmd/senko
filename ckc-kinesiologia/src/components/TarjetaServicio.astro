---
/**
 * Tarjeta de servicio de la landing.
 *
 * Al ser una sola página no hay adónde enlazar: la tarjeta se despliega en el
 * lugar con <details>, que funciona sin JavaScript y es accesible con teclado
 * de forma nativa. Adentro va el contenido que antes vivía en la página de
 * cada servicio, resumido: en qué consiste, cuándo puede estar indicado y qué
 * busca el tratamiento.
 */
import Visual from './Visual.astro';
import BotonTurno from './BotonTurno.astro';
import { MENSAJES } from '@/data/site';
import { fotoDeServicio, TEXTOS_ALT } from '@/data/fotos';
import type { Servicio } from '@/data/servicios';

interface Props {
  servicio: Servicio;
  retardo?: number;
}

const { servicio, retardo = 0 } = Astro.props;
const foto = fotoDeServicio(servicio.slug);
---

<article
  class="tarjeta"
  id={`servicio-${servicio.slug}`}
  data-animar
  style={`--retardo:${retardo}ms`}
>
  <div class="tarjeta__visual">
    <Visual
      src={foto ?? undefined}
      alt={foto ? TEXTOS_ALT[servicio.slug] : undefined}
      proporcion="16/9"
      motivo={servicio.motivo}
      tono={servicio.tono}
      rotulo={foto ? undefined : servicio.fotoSugerida}
      ancho={560}
    />
  </div>

  <div class="tarjeta__cuerpo">
    <h3 class="tarjeta__titulo">{servicio.nombre}</h3>
    <p class="tarjeta__resumen">{servicio.resumen}</p>

    <div class="tarjeta__cuando">
      <p class="tarjeta__rotulo">Puede ser relevante si…</p>
      <ul>
        {servicio.cuandoResumen.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    {/* --- Detalle desplegable --- */}
    <details class="tarjeta__detalle">
      <summary>
        <span>Ver en qué consiste</span>
        <span class="tarjeta__signo" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" focusable="false">
            <path
              d="M10 4.5v11M4.5 10h11"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
        </span>
      </summary>

      <div class="tarjeta__detalle-cuerpo">
        {servicio.descripcion.slice(0, 2).map((p) => <p>{p}</p>)}

        <p class="tarjeta__rotulo">Qué busca el tratamiento</p>
        <ul class="tarjeta__objetivos">
          {servicio.objetivos.slice(0, 3).map((o) => <li>{o}</li>)}
        </ul>

        {
          servicio.advertencia && (
            <p class="tarjeta__advertencia">{servicio.advertencia}</p>
          )
        }
      </div>
    </details>

    <div class="tarjeta__accion">
      <BotonTurno
        mensaje={MENSAJES.servicio(servicio.nombreConsulta)}
        texto="Consultar por este servicio"
        variante="contorno"
      />
    </div>
  </div>
</article>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio-lg);
    overflow: hidden;
    scroll-margin-top: calc(var(--ckc-alto-encabezado) + 1.5rem);
    transition:
      border-color var(--ckc-trans),
      box-shadow var(--ckc-trans),
      translate var(--ckc-trans);
  }

  .tarjeta:hover {
    border-color: color-mix(in srgb, var(--ckc-primario) 32%, transparent);
    box-shadow: var(--ckc-sombra);
    translate: 0 -3px;
  }

  .tarjeta__visual :global(.ckc-visual) {
    border-radius: 0;
  }

  .tarjeta__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--ckc-esp-3);
    padding: var(--ckc-esp-6);
    flex: 1;
  }

  .tarjeta__titulo {
    font-size: var(--ckc-txt-lg);
    margin: 0;
  }

  .tarjeta__resumen {
    font-size: var(--ckc-txt-sm);
    line-height: 1.65;
    color: var(--ckc-tinta-media);
  }

  .tarjeta__rotulo {
    font-size: var(--ckc-txt-xs);
    font-weight: var(--ckc-peso-fuerte);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ckc-acento);
    margin-bottom: var(--ckc-esp-2);
  }

  .tarjeta__cuando {
    margin-top: auto;
    padding-top: var(--ckc-esp-3);
  }

  .tarjeta__cuando ul,
  .tarjeta__objetivos {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }

  .tarjeta__cuando li,
  .tarjeta__objetivos li {
    position: relative;
    padding-left: 1.2rem;
    font-size: var(--ckc-txt-sm);
    line-height: 1.55;
    color: var(--ckc-tinta-media);
  }

  .tarjeta__cuando li::before,
  .tarjeta__objetivos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ckc-acento-vivo);
  }

  /* --- Detalle desplegable --------------------------------------------- */

  .tarjeta__detalle {
    margin-top: var(--ckc-esp-4);
    border-top: 1px solid var(--ckc-linea-suave);
  }

  .tarjeta__detalle summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ckc-esp-3);
    min-height: var(--ckc-tactil-min);
    padding-top: var(--ckc-esp-3);
    font-size: var(--ckc-txt-sm);
    font-weight: var(--ckc-peso-fuerte);
    color: var(--ckc-primario);
    cursor: pointer;
    list-style: none;
  }

  .tarjeta__detalle summary::-webkit-details-marker {
    display: none;
  }

  .tarjeta__detalle summary::marker {
    content: '';
  }

  .tarjeta__signo {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border: 1px solid var(--ckc-linea);
    border-radius: 50%;
    transition: rotate var(--ckc-trans), background-color var(--ckc-trans);
  }

  .tarjeta__signo svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .tarjeta__detalle[open] .tarjeta__signo {
    rotate: 135deg;
    background: var(--ckc-primario-claro);
    border-color: transparent;
  }

  .tarjeta__detalle-cuerpo {
    padding-block: var(--ckc-esp-3) var(--ckc-esp-2);
    display: grid;
    gap: var(--ckc-esp-3);
  }

  .tarjeta__detalle-cuerpo p {
    font-size: var(--ckc-txt-sm);
    line-height: 1.68;
    color: var(--ckc-tinta-media);
  }

  .tarjeta__advertencia {
    padding: 0.75rem 0.95rem;
    border-radius: var(--ckc-radio-sm);
    background: var(--ckc-aviso-fondo);
    font-size: var(--ckc-txt-xs) !important;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ckc-aviso) 92%, #000) !important;
  }

  .tarjeta__accion {
    margin-top: var(--ckc-esp-4);
    padding-top: var(--ckc-esp-4);
    border-top: 1px solid var(--ckc-linea-suave);
  }
</style>
