---
/**
 * Boton flotante de contacto.
 *
 * Queda visible mientras se recorre la pagina, pero:
 *  - aparece recien despues de bajar un poco, para no tapar el hero;
 *  - se esconde solo al llegar al pie, para no superponerse con el contenido
 *    ni con los enlaces del final;
 *  - respeta el area segura de los celulares con pantalla completa.
 */
import { enlaceWhatsApp, whatsAppActivo } from '@/lib/enlaces';
import { MENSAJES } from '@/data/site';

const href = enlaceWhatsApp(MENSAJES.turno);
const activo = whatsAppActivo();
const externo = activo
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  class="ckc-flotante"
  href={href}
  data-flotante
  aria-label={
    activo
      ? 'Solicitar un turno por WhatsApp'
      : 'Solicitar un turno: ver los canales de contacto'
  }
  {...externo}
>
  {
    activo ? (
      <svg class="ckc-flotante__icono" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.22-1.37a9.9 9.9 0 0 0 4.82 1.23h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.88 9.88 0 0 0 12.04 2Zm0 1.67c2.21 0 4.29.86 5.85 2.43a8.23 8.23 0 0 1 2.43 5.86c0 4.58-3.72 8.3-8.29 8.3a8.26 8.26 0 0 1-4.21-1.15l-.3-.18-3.1.81.83-3.02-.19-.31a8.24 8.24 0 0 1-1.27-4.42c0-4.58 3.72-8.3 8.3-8.3Zm-3.1 4.3c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.42 1.02 2.59.13.16 1.75 2.72 4.24 3.7 2.07.82 2.49.65 2.94.61.45-.04 1.45-.59 1.66-1.17.2-.57.2-1.07.14-1.17-.06-.1-.23-.17-.48-.29-.25-.12-1.45-.71-1.67-.79-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.98-.14.16-.29.19-.54.06-.25-.12-1.05-.38-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.12.29-.31.43-.47.14-.16.19-.27.29-.45.1-.17.05-.33-.02-.45-.06-.13-.56-1.36-.77-1.86-.2-.49-.4-.42-.56-.43h-.5Z" />
      </svg>
    ) : (
      <svg class="ckc-flotante__icono" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path
          d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4 3v-3h-.5A1.5 1.5 0 0 1 4 15.5v-8Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  <span class="ckc-flotante__texto">Solicitar turno</span>
</a>

<style>
  .ckc-flotante {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: calc(clamp(1rem, 3vw, 1.75rem) + env(safe-area-inset-bottom));
    z-index: var(--ckc-z-flotante);

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 54px;
    padding: 0.85rem 1.4rem;

    background-color: var(--ckc-primario);
    color: var(--ckc-blanco);
    border-radius: var(--ckc-radio-pastilla);
    box-shadow: var(--ckc-sombra-lg);

    font-size: var(--ckc-txt-sm);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;

    /* Oculto hasta que se empieza a bajar. */
    opacity: 0;
    translate: 0 1rem;
    pointer-events: none;
    transition:
      opacity var(--ckc-trans),
      translate var(--ckc-trans),
      background-color var(--ckc-trans);
  }

  .ckc-flotante[data-visible='true'] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }

  .ckc-flotante:hover {
    background-color: var(--ckc-primario-oscuro);
    color: var(--ckc-blanco);
  }

  .ckc-flotante__icono {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
  }

  /* En celulares angostos queda solo el icono, para no tapar el contenido. */
  @media (max-width: 26rem) {
    .ckc-flotante {
      padding: 0;
      width: 56px;
      height: 56px;
      min-height: 56px;
      justify-content: center;
    }

    .ckc-flotante__texto {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media print {
    .ckc-flotante {
      display: none;
    }
  }
</style>

<script>
  const flotante = document.querySelector<HTMLElement>('[data-flotante]');
  const pie = document.querySelector('footer');

  if (flotante) {
    let cercaDelPie = false;

    // Se esconde cuando el pie entra en pantalla, para no taparlo.
    if (pie && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entrada]) => {
          cercaDelPie = entrada.isIntersecting;
          actualizar();
        },
        { rootMargin: '0px 0px -40% 0px' },
      ).observe(pie);
    }

    function actualizar() {
      const bajo = window.scrollY > 520;
      flotante!.dataset.visible = bajo && !cercaDelPie ? 'true' : 'false';
    }

    actualizar();
    window.addEventListener('scroll', actualizar, { passive: true });
  }
</script>
