---
/**
 * Clubes e instituciones con las que trabaja el consultorio.
 *
 * Es la prueba social más fuerte de un centro con perfil deportivo: un
 * escudo reconocible convence más que tres párrafos.
 *
 * Mientras no haya instituciones cargadas en src/data/trayectoria.ts, se
 * muestran casilleros vacíos con el diseño final y un aviso claro. No se
 * inventa ningún nombre: nombrar un club con el que no existe vínculo sería
 * una afirmación falsa sobre un tercero.
 */
import { Image } from 'astro:assets';
import { INSTITUCIONES, hayInstituciones } from '@/data/trayectoria';

interface Props {
  /** Cantidad de casilleros vacíos a mostrar mientras no haya datos. */
  vacios?: number;
}

const { vacios = 6 } = Astro.props;
---

<div class="muro">
  {
    hayInstituciones ? (
      <ul class="muro__lista">
        {INSTITUCIONES.map((inst, i) => {
          const Contenedor = inst.url ? 'a' : 'div';
          return (
            <li data-animar style={`--retardo:${i * 55}ms`}>
              <Contenedor
                class="muro__ficha"
                href={inst.url}
                target={inst.url ? '_blank' : undefined}
                rel={inst.url ? 'noopener noreferrer' : undefined}
              >
                {inst.logo ? (
                  <Image
                    src={inst.logo}
                    alt={`Escudo de ${inst.nombre}`}
                    width={160}
                    densities={[1, 2]}
                    loading="lazy"
                    decoding="async"
                    class="muro__logo"
                  />
                ) : (
                  <span class="muro__inicial" aria-hidden="true">
                    {inst.nombre.charAt(0)}
                  </span>
                )}
                <span class="muro__texto">
                  <span class="muro__nombre">{inst.nombre}</span>
                  <span class="muro__tipo">{inst.tipo}</span>
                  {inst.detalle && <span class="muro__detalle">{inst.detalle}</span>}
                </span>
              </Contenedor>
            </li>
          );
        })}
      </ul>
    ) : (
      <Fragment>
        <ul class="muro__lista muro__lista--vacia" aria-hidden="true">
          {Array.from({ length: vacios }).map((_, i) => (
            <li data-animar style={`--retardo:${i * 55}ms`}>
              <div class="muro__ficha muro__ficha--vacia">
                <span class="muro__hueco"></span>
                <span class="muro__lineas">
                  <span></span>
                  <span></span>
                </span>
              </div>
            </li>
          ))}
        </ul>

        <p class="muro__aviso">
          <strong>Escudos y nombres pendientes.</strong> No cargamos ningún club por
          nuestra cuenta: nombrar una institución con la que no existe vínculo sería
          una afirmación falsa sobre un tercero. Pasanos la lista y, antes de
          publicarla, conviene pedirle a cada club autorización para usar su nombre y
          su escudo.
        </p>
      </Fragment>
    )
  }
</div>

<style>
  .muro__lista {
    display: grid;
    gap: var(--ckc-esp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    list-style: none;
    margin: 0;
  }

  .muro__ficha {
    display: flex;
    align-items: center;
    gap: var(--ckc-esp-4);
    height: 100%;
    min-width: 0;
    padding: var(--ckc-esp-4) var(--ckc-esp-5);
    background: var(--ckc-blanco);
    border: 1px solid var(--ckc-linea);
    border-radius: var(--ckc-radio-md);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--ckc-trans),
      box-shadow var(--ckc-trans),
      translate var(--ckc-trans);
  }

  a.muro__ficha:hover {
    border-color: var(--ckc-primario);
    box-shadow: var(--ckc-sombra-md);
    translate: 0 -2px;
  }

  .muro__logo {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
  }

  .muro__inicial {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--ckc-primario-claro);
    color: var(--ckc-primario);
    font-family: var(--ckc-fuente-titulo);
    font-size: 1.5rem;
  }

  .muro__texto {
    min-width: 0;
  }

  .muro__nombre {
    display: block;
    font-family: var(--ckc-fuente-titulo);
    font-size: var(--ckc-txt-base);
    line-height: 1.3;
    color: var(--ckc-primario-oscuro);
  }

  .muro__tipo {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ckc-acento);
  }

  .muro__detalle {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--ckc-txt-xs);
    line-height: 1.5;
    color: var(--ckc-tinta-suave);
  }

  /* --- Casilleros vacíos ------------------------------------------------ */

  .muro__ficha--vacia {
    background: color-mix(in srgb, var(--ckc-blanco) 55%, transparent);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--ckc-primario) 22%, transparent);
  }

  .muro__hueco {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--ckc-primario) 30%, transparent);
  }

  .muro__lineas {
    display: grid;
    gap: 0.45rem;
    flex: 1;
    min-width: 0;
  }

  .muro__lineas span {
    display: block;
    height: 0.55rem;
    border-radius: var(--ckc-radio-pastilla);
    background: color-mix(in srgb, var(--ckc-primario) 11%, transparent);
  }

  .muro__lineas span:last-child {
    width: 55%;
    height: 0.45rem;
  }

  .muro__aviso {
    margin-top: var(--ckc-esp-5);
    padding: 1rem 1.25rem;
    max-width: 52rem;
    border-radius: var(--ckc-radio);
    background: var(--ckc-aviso-fondo);
    border: 1px solid color-mix(in srgb, var(--ckc-aviso) 24%, transparent);
    font-size: var(--ckc-txt-sm);
    line-height: 1.65;
    color: color-mix(in srgb, var(--ckc-aviso) 88%, #000);
  }

  .muro__aviso strong {
    color: inherit;
  }
</style>
