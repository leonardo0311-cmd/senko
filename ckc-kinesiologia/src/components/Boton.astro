---
import { atributosEnlace } from '@/lib/enlaces';

interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'contorno' | 'texto' | 'claro';
  tamanio?: 'md' | 'lg';
  /** Muestra el icono de WhatsApp a la izquierda del texto. */
  whatsapp?: boolean;
  /** Muestra una flecha a la derecha del texto. */
  flecha?: boolean;
  /** Ocupa todo el ancho disponible. */
  ancho?: boolean;
  /** Etiqueta accesible, si el texto visible no alcanza por si solo. */
  etiqueta?: string;
  class?: string;
}

const {
  href,
  variante = 'primario',
  tamanio = 'md',
  whatsapp = false,
  flecha = false,
  ancho = false,
  etiqueta,
  class: clase,
} = Astro.props;

const externos = atributosEnlace(href);
---

<a
  href={href}
  class:list={[
    'ckc-boton',
    `ckc-boton--${variante}`,
    `ckc-boton--${tamanio}`,
    ancho && 'ckc-boton--ancho',
    clase,
  ]}
  aria-label={etiqueta}
  {...externos}
>
  {
    whatsapp && (
      <svg
        class="ckc-boton__icono"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.22-1.37a9.9 9.9 0 0 0 4.82 1.23h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.88 9.88 0 0 0 12.04 2Zm0 1.67c2.21 0 4.29.86 5.85 2.43a8.23 8.23 0 0 1 2.43 5.86c0 4.58-3.72 8.3-8.29 8.3a8.26 8.26 0 0 1-4.21-1.15l-.3-.18-3.1.81.83-3.02-.19-.31a8.24 8.24 0 0 1-1.27-4.42c0-4.58 3.72-8.3 8.3-8.3Zm-3.1 4.3c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.42 1.02 2.59.13.16 1.75 2.72 4.24 3.7 2.07.82 2.49.65 2.94.61.45-.04 1.45-.59 1.66-1.17.2-.57.2-1.07.14-1.17-.06-.1-.23-.17-.48-.29-.25-.12-1.45-.71-1.67-.79-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.98-.14.16-.29.19-.54.06-.25-.12-1.05-.38-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.12.29-.31.43-.47.14-.16.19-.27.29-.45.1-.17.05-.33-.02-.45-.06-.13-.56-1.36-.77-1.86-.2-.49-.4-.42-.56-.43h-.5Z"
        />
      </svg>
    )
  }
  <span class="ckc-boton__texto"><slot /></span>
  {
    flecha && (
      <svg
        class="ckc-boton__flecha"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M4 10h11M11 5.5 15.5 10 11 14.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>

<style>
  .ckc-boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: var(--ckc-tactil-min);
    padding: 0.8rem 1.5rem;
    border-radius: var(--ckc-radio-pastilla);
    font-family: var(--ckc-fuente-texto);
    font-size: var(--ckc-txt-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    text-align: center;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition:
      background-color var(--ckc-trans),
      border-color var(--ckc-trans),
      color var(--ckc-trans),
      box-shadow var(--ckc-trans),
      translate var(--ckc-trans);
    -webkit-tap-highlight-color: transparent;
  }

  .ckc-boton:hover {
    translate: 0 -1px;
  }

  .ckc-boton:active {
    translate: 0 0;
  }

  .ckc-boton__texto {
    /* Evita que el texto se corte en celulares angostos. */
    text-wrap: balance;
  }

  .ckc-boton__icono {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
  }

  .ckc-boton__flecha {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    transition: translate var(--ckc-trans);
  }

  .ckc-boton:hover .ckc-boton__flecha {
    translate: 3px 0;
  }

  /* --- Variantes -------------------------------------------------------- */

  .ckc-boton--primario {
    background-color: var(--ckc-primario);
    border-color: var(--ckc-primario);
    color: var(--ckc-blanco);
    box-shadow: var(--ckc-sombra-sm);
  }

  .ckc-boton--primario:hover {
    background-color: var(--ckc-primario-oscuro);
    border-color: var(--ckc-primario-oscuro);
    color: var(--ckc-blanco);
    box-shadow: var(--ckc-sombra-md);
  }

  .ckc-boton--secundario {
    background-color: var(--ckc-acento);
    border-color: var(--ckc-acento);
    color: var(--ckc-blanco);
    box-shadow: var(--ckc-sombra-sm);
  }

  .ckc-boton--secundario:hover {
    background-color: color-mix(in srgb, var(--ckc-acento) 82%, #000);
    border-color: color-mix(in srgb, var(--ckc-acento) 82%, #000);
    color: var(--ckc-blanco);
    box-shadow: var(--ckc-sombra-md);
  }

  .ckc-boton--contorno {
    background-color: transparent;
    border-color: color-mix(in srgb, var(--ckc-primario) 32%, transparent);
    color: var(--ckc-primario-oscuro);
  }

  .ckc-boton--contorno:hover {
    background-color: var(--ckc-primario-claro);
    border-color: var(--ckc-primario);
    color: var(--ckc-primario-oscuro);
  }

  .ckc-boton--claro {
    background-color: var(--ckc-blanco);
    border-color: var(--ckc-blanco);
    color: var(--ckc-primario-oscuro);
  }

  .ckc-boton--claro:hover {
    background-color: var(--ckc-primario-claro);
    border-color: var(--ckc-primario-claro);
    color: var(--ckc-primario-oscuro);
    box-shadow: var(--ckc-sombra-md);
  }

  .ckc-boton--texto {
    background: none;
    border-color: transparent;
    color: var(--ckc-primario);
    padding-inline: 0;
    min-height: 2.5rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ckc-primario) 30%, transparent);
    text-underline-offset: 0.25em;
  }

  .ckc-boton--texto:hover {
    color: var(--ckc-primario-oscuro);
    text-decoration-color: currentColor;
    translate: none;
  }

  /* --- Tamaños ---------------------------------------------------------- */

  .ckc-boton--lg {
    padding: 1rem 1.9rem;
    font-size: var(--ckc-txt-base);
    min-height: 54px;
  }

  .ckc-boton--ancho {
    width: 100%;
  }

  /* En celulares muy angostos, los botones pasan a ocupar todo el ancho
     para que el area de toque sea comoda. */
  @media (max-width: 26rem) {
    .ckc-boton:not(.ckc-boton--texto) {
      width: 100%;
    }
  }
</style>
